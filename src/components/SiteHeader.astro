---
/** Site chrome: brand, primary nav, locale switcher. All text via `t()` (I18N-08). */
import LocaleSwitcher from "./LocaleSwitcher.astro";
import {
  localeHref,
  type Locale,
  type LocalizedRoutePaths,
} from "../i18n/routing";
import { collectionRoutePath } from "../i18n/routes";
import { t } from "../i18n/ui";
import { SITE_NAME } from "../site";

interface Props {
  locale: Locale;
  routePath: string;
  /** This page's route in every locale, when its segment is translated. */
  routePathByLocale?: LocalizedRoutePaths;
}

const { locale, routePath, routePathByLocale } = Astro.props;
const strings = t(locale);

/**
 * Nav destinations, resolved in *this* locale. A collection whose segment is
 * translated is linked through `collectionRoutePath`, never by writing the
 * path twice — the registry is the only place a segment exists (I18N-05).
 */
const navItems = [
  { href: "/", label: strings.navHome },
  /**
   * T401 — the problem finder. Second, right after Home, because it is the
   * artboard's own nav order and because it is the reason most readers arrive
   * (AGENTS.md: "comprehensive enough that someone with a broken Montero finds
   * their answer here").
   */
  {
    href: collectionRoutePath("problems", locale),
    label: strings.navProblems,
  },
  {
    href: collectionRoutePath("glossary", locale),
    label: strings.navGlossary,
  },
  {
    href: collectionRoutePath("community", locale),
    label: strings.navCommunity,
  },
  /**
   * T702 — the site-wide search page (SRCH-01). Placed after the content
   * sections it searches across (problems, glossary, community) and before
   * the account-flow items below, the same "reference first" ordering
   * `navSignIn`'s own comment states for this list.
   */
  {
    href: collectionRoutePath("search", locale),
    label: strings.navSearch,
  },
  /**
   * 002 T2-301 — the garage. A signed-out visitor who follows it gets the
   * bilingual sign-in prompt rather than an error, which is the point: the
   * door has to be visible before anyone knows there is a room.
   */
  {
    href: collectionRoutePath("garage", locale),
    label: strings.navGarage,
  },
  /**
   * 002 T2-202 — the account surface has to be reachable from the chrome, in
   * both locales, or ACC-02's "fully bilingual account surface" is a page with
   * no door. It is last on purpose: this is a reference site first.
   */
  {
    href: collectionRoutePath("signIn", locale),
    label: strings.navSignIn,
  },
];
---

<header>
  <a class="brand" href={localeHref(locale, "/")}>
    <strong>{SITE_NAME}</strong>
    <span>{strings.siteTagline}</span>
  </a>
  <nav aria-label={strings.navLabel}>
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a
              href={localeHref(locale, item.href)}
              aria-current={routePath === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <LocaleSwitcher
    locale={locale}
    routePath={routePath}
    routePathByLocale={routePathByLocale}
  />
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem;
  }

  header nav ul {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .brand {
    display: flex;
    flex-direction: column;
  }
</style>
