---
/**
 * The public community directory page (T703a, COM-01, COM-02).
 *
 * > **COM-01** THE `community` collection SHALL hold forums, subreddits,
 * > groups, Discords, clubs, channels, vendors, and shops — tagged by
 * > region, language, generation focus, activity level, and "what it's good
 * > for" in both locales.
 * >
 * > **COM-02** Spanish-language and Central American communities SHALL be
 * > first-class entries, not an appendix.
 *
 * ## One page, two URLs, one component (I18N-01)
 *
 * Same seam T205 built for the glossary: the segment is translated
 * (`/en/community/` and `/es/comunidad/`), so this file is parameterized on
 * it and `getStaticPaths` reads both values from `src/i18n/routes.ts`'s
 * registry. Neither locale is a redirect of the other.
 *
 * ## Bilingual scope — narrower than the glossary's, on purpose
 *
 * The glossary shows both languages on every card because its entire point
 * is EN/ES term equivalence. A directory entry is not a term: `/en/community/`
 * renders each card's `prose.en` and `/es/comunidad/` renders `prose.es`, one
 * locale per page, like every other content page will. The one place both
 * languages render together regardless of page locale is the confidence
 * caveat below, because AGENTS.md's rule is textual ("a visible caveat in
 * both languages"), not page-scoped.
 *
 * ## The confidence caveat (AGENTS.md "Facts")
 *
 * Every one of T701's twelve entries is `first-hand` or `anecdotal` — both
 * weaker than `tsb` — so every card on this page renders the caveat today;
 * the check is per-entry (`src/lib/confidence.ts`) so a future
 * `community-consensus` entry (COM-01's "community-consensus" reading) is
 * still caught correctly. Rendered page-locale first, other locale smaller
 * below, the same order the design handoff's triage banner uses for a
 * bilingual-always block.
 *
 * ## Filtering
 *
 * Four independent facets — region, language, generation, activity — each a
 * pill group in the Glosario artboard's filter-pill vocabulary (active =
 * ink-filled). Client-side and progressive: the toolbar is laid out only when
 * the document is marked script-capable (see the CSS note below), so a visitor
 * with no JavaScript sees every entry and no dead control. What a facet *matches* is
 * `src/lib/community-filter.ts`, unit-tested without a browser; this script
 * is DOM wiring only.
 *
 * ## The vehicle filter is a *second*, differently-shaped filter (T204, FIT-03)
 *
 * The four pills above **hide** what does not match: a reader who picks
 * "Costa Rica" is asking for a shorter list. The vehicle selector does not
 * hide anything — a row that does not fit the reader's truck stays on the
 * page at 55% opacity, carrying a "filtered" tag, exactly as the Selector
 * artboard draws it ("never hidden silently"). The two are different
 * questions: a facet pill is the reader narrowing on purpose, while a
 * fitment mismatch is the *site* deciding something is not for them, and the
 * site owes them the chance to disagree.
 *
 * Whether an entry fits is `matchesVehicle` and only `matchesVehicle`
 * (FIT-01). Whether the fit was *provisional* — matched partly because the
 * reader has not said which transfer case they have — is
 * `provisionalMatchFacets`, and it is rendered per row, because that is the
 * binding condition under which T203's permissive semantics were accepted
 * (T203 review, F8): the trade-off is only safe if the reader can see it.
 *
 * ## Dates
 *
 * `activityAssessed` renders through `Intl.DateTimeFormat` in the page
 * locale, inside a `<time datetime="…">` carrying the stored `YYYY-MM-DD`.
 * That answers the ambiguity T703a's F5 note deferred to this task — a long
 * month name cannot be read day-first or month-first by mistake, and the
 * machine-readable form is still in the markup for anything that wants it.
 *
 * ## Region and language names
 *
 * Rendered via `Intl.DisplayNames(locale, …)`, never hand-mapped — the same
 * rule `src/schemas/community.ts` uses to *validate* these codes in the first
 * place (its module docstring explains why: an invented geography/language
 * list would need a schema change the first time a researcher found a club
 * somewhere nobody had enumerated). A code with no CLDR display name cannot
 * reach this page at all, because the schema already rejected it.
 *
 * ## Styling
 *
 * Palette, type scale and card anatomy follow the Glosario artboard's term
 * cards plus the confidence-caveat and confidence-chip tokens from
 * `specs/001-foundation/design/HANDOFF-DESIGN.md` — there is no dedicated
 * community artboard, so this composes the documented vocabulary rather than
 * inventing a new one. Region/language/generation tags render in IBM Plex
 * Mono per the handoff's "if a value comes from shared `data`, it renders in
 * Plex Mono" rule (these are CLDR/taxonomy codes, exactly that kind of
 * value); translated *labels* (type chip, activity badge) render in Archivo.
 *
 * refs specs/001-foundation (COM-01, COM-02, I18N-01, I18N-04, I18N-08)
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  LOCALES,
  LOCALE_BCP47,
  isLocale,
  type Locale,
} from "../../i18n/routing";
import { collectionRouteParams, collectionRoutePaths } from "../../i18n/routes";
import VehicleFitSummary from "../../components/VehicleFitSummary.astro";
import {
  communityActivityLabel,
  communityLinkKindLabel,
  communityTypeLabel,
  confidenceCaveat,
  generationLabel,
  t,
} from "../../i18n/ui";
import { formatCount } from "../../lib/glossary-filter";
import { directoryListing } from "../../lib/directory/neutral-order";
import { needsConfidenceCaveat } from "../../lib/confidence";
import { buildTaxonomy, expandGenerations } from "../../lib/fitment";
import { buildFitmentTable } from "../../lib/vehicle-listing";
import { selectorTaxonomyData } from "../../lib/vehicle-taxonomy";
import {
  ACTIVITY_LEVELS,
  WORLDWIDE_REGION,
  type ActivityLevel,
  type CommunityLink,
} from "../../schemas/community";
import { GENERATION_IDS, type GenerationId } from "../../schemas/vehicles";
import type { ConfidenceTier } from "../../schemas/entry";

export function getStaticPaths() {
  return collectionRouteParams("community", "communitySegment");
}

const { locale: param } = Astro.params;
if (!isLocale(param)) {
  throw new Error(`Unknown locale segment: ${String(param)}`);
}
const locale: Locale = param;
const strings = t(locale);
const routes = collectionRoutePaths("community");

const otherLocale = LOCALES.find((candidate) => candidate !== locale) as Locale;
/** Page locale first — the handoff's rule for a bilingual-always block. */
const readingOrder: Locale[] = [locale, otherLocale];

const collator = new Intl.Collator(LOCALE_BCP47[locale], {
  sensitivity: "base",
});
const regionNames = new Intl.DisplayNames([locale], {
  type: "region",
  fallback: "code",
});
const languageNames = new Intl.DisplayNames([locale], {
  type: "language",
  fallback: "code",
});

/** A `GENERATION_IDS` value if `id` is one, else the raw string unchanged. */
function isKnownGeneration(id: string): id is GenerationId {
  return (GENERATION_IDS as readonly string[]).includes(id);
}

/**
 * A region code's display name. `WORLDWIDE_REGION` (`001`) is special-cased
 * to `strings.communityRegionWorldwide` rather than `Intl.DisplayNames`,
 * which gives EN a lowercase `"world"` next to title-cased siblings like
 * "Costa Rica" (code review F2).
 */
function regionLabelFor(code: string): string {
  if (code === WORLDWIDE_REGION) return strings.communityRegionWorldwide;
  return regionNames.of(code) ?? code;
}

/** The bilingual confidence-caveat sentence, in `each` locale's own words. */
function caveatSentence(each: Locale, tier: ConfidenceTier): string {
  return confidenceCaveat(t(each), tier);
}

/**
 * The same taxonomy the selector ships to the browser, built here so the
 * *server* render answers generation questions the same way the client does —
 * one engine, one answer, whichever side of the wire asks (FIT-01).
 */
const taxonomy = buildTaxonomy(
  selectorTaxonomyData(
    (await getCollection("vehicles")).map((entry) => entry.data)
  ).nodes
);

/** `2026-08-28` → `28 de agosto de 2026` / `August 28, 2026`. */
const assessedDate = new Intl.DateTimeFormat(LOCALE_BCP47[locale], {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

function formatAssessed(iso: string): string {
  // Parsed as UTC midnight, formatted in UTC: an ISO date is a calendar day,
  // and letting the runtime's local zone shift it would print the day before
  // for anyone west of Greenwich — Costa Rica included.
  return assessedDate.format(new Date(`${iso}T00:00:00Z`));
}

const entries = await getCollection("community");

const communities = entries.map((entry) => {
  const {
    communityType,
    regions,
    languages,
    activity,
    activityAssessed,
    url,
    links,
    confidence,
    fitment,
    prose,
  } = entry.data;
  const local = prose[locale];
  const gens = fitment.gens;
  const linkList: CommunityLink[] = links ?? [];

  return {
    id: entry.id,
    domId: `community-${entry.id.replace(/\//g, "--")}`,
    typeLabel: communityTypeLabel(strings, communityType),
    regions,
    regionLabels: regions.map(regionLabelFor),
    languages,
    languageLabels: languages.map((tag) => languageNames.of(tag) ?? tag),
    gens,
    /**
     * The generations this entry's fitment *covers*, engine-expanded — a
     * club scoped to `["gen2"]` covers the `gen2-5` facelift too. Rendered
     * as the tags, and read by the client filter, so the page and the
     * filter cannot disagree about what an entry is for.
     */
    coveredGens: expandGenerations(gens, taxonomy),
    genLabels: expandGenerations(gens, taxonomy).map((id) =>
      isKnownGeneration(id) ? generationLabel(strings, id) : id
    ),
    fitment,
    activity: activity as ActivityLevel,
    activityLabel: communityActivityLabel(strings, activity as ActivityLevel),
    activityAssessed,
    url,
    links: linkList.map((link) => ({
      ...link,
      label: communityLinkKindLabel(strings, link.kind),
    })),
    showCaveat: needsConfidenceCaveat(confidence),
    caveatByLocale: Object.fromEntries(
      readingOrder.map((each) => [each, caveatSentence(each, confidence)])
    ) as Record<Locale, string>,
    title: local.title,
    summary: local.summary,
    goodFor: local.goodFor,
  };
});

/**
 * SHP-05 — the directory's order and inclusion are delegated to the neutral
 * orderer (`src/lib/directory/neutral-order.ts`), never computed inline here.
 * `directoryListing` is a pure function of the git-owned community content, so
 * the order and the set of entries shown are provably independent of whether any
 * shop has a claim, an account, or a plan (graded by
 * `tests/shop/directory.test.ts` and `tests/pages/directory-neutrality.render.test.ts`;
 * MON-05 restates it as a money rule for the day a plan exists). The locale
 * collator is the one neutral presentation facet — it only ever sees two title
 * strings, so it cannot make the order depend on anything but the content — and
 * it is what keeps `/es/comunidad/` collating in Spanish and `/en/community/` in
 * English, exactly as the inline sort did before the extraction.
 */
const byId = new Map(communities.map((community) => [community.id, community]));
const orderedCommunities = directoryListing(
  communities.map((community) => ({
    id: community.id,
    title: community.title,
  })),
  {},
  (a, b) => collator.compare(a, b)
)
  .map((id) => byId.get(id))
  .filter(
    (community): community is (typeof communities)[number] =>
      community !== undefined
  );

/** Sorted-by-label option list for a facet, built only from codes in use. */
function labeledOptions(
  values: readonly { code: string; label: string }[]
): { code: string; label: string }[] {
  const byCode = new Map<string, string>();
  for (const { code, label } of values) byCode.set(code, label);
  return [...byCode.entries()]
    .map(([code, label]) => ({ code, label }))
    .sort((a, b) => collator.compare(a.label, b.label));
}

const regionOptions = labeledOptions(
  communities.flatMap((community) =>
    community.regions.map((code, index) => ({
      code,
      label: community.regionLabels[index] ?? code,
    }))
  )
);

const languageOptions = labeledOptions(
  communities.flatMap((community) =>
    community.languages.map((code, index) => ({
      code,
      label: community.languageLabels[index] ?? code,
    }))
  )
);

/** Canonical taxonomy order, not alphabetical — same rule the system pills use. */
const generationOptions = GENERATION_IDS.filter((id) =>
  communities.some((community) => community.coveredGens.includes(id))
).map((id) => ({ code: id, label: generationLabel(strings, id) }));

/**
 * One entry per *distinct* fitment, so a listing whose rows mostly share one
 * does not repeat it in every card's attribute (T204 review, F3).
 */
const fitmentTable = buildFitmentTable(
  communities.map((community) => community.fitment)
);

/** Most-active-first, per `ACTIVITY_LEVELS`' own order. */
const activityOptions = ACTIVITY_LEVELS.filter((level) =>
  communities.some((community) => community.activity === level)
).map((level) => ({
  code: level,
  label: communityActivityLabel(strings, level),
}));
---

<BaseLayout
  locale={locale}
  routePathByLocale={routes}
  title={`${strings.communityHeading} — ${strings.siteTagline}`}
  description={strings.communityIntro}
>
  <section class="community" data-community>
    <div class="community__intro">
      <h1>{strings.communityHeading}</h1>
      <p>{strings.communityIntro}</p>
    </div>

    {
      communities.length === 0 ? (
        <p class="community__empty">{strings.communityEmpty}</p>
      ) : (
        <>
          <div class="community__toolbar" data-community-toolbar>
            <div class="community__filter-group">
              <span class="community__filter-label">
                {strings.communityFilterRegionLabel}
              </span>
              <div
                class="community__pills"
                role="group"
                aria-label={strings.communityFilterRegionLabel}
              >
                <button
                  type="button"
                  data-facet="region"
                  data-value=""
                  aria-pressed="true"
                >
                  {strings.communityFilterRegionAll}
                </button>
                {regionOptions.map((option) => (
                  <button
                    type="button"
                    data-facet="region"
                    data-value={option.code}
                    aria-pressed="false"
                  >
                    {option.label}
                  </button>
                ))}
              </div>
            </div>

            <div class="community__filter-group">
              <span class="community__filter-label">
                {strings.communityFilterLanguageLabel}
              </span>
              <div
                class="community__pills"
                role="group"
                aria-label={strings.communityFilterLanguageLabel}
              >
                <button
                  type="button"
                  data-facet="language"
                  data-value=""
                  aria-pressed="true"
                >
                  {strings.communityFilterLanguageAll}
                </button>
                {languageOptions.map((option) => (
                  <button
                    type="button"
                    data-facet="language"
                    data-value={option.code}
                    aria-pressed="false"
                  >
                    {option.label}
                  </button>
                ))}
              </div>
            </div>

            <div class="community__filter-group">
              <span class="community__filter-label">
                {strings.communityFilterGenerationLabel}
              </span>
              <div
                class="community__pills"
                role="group"
                aria-label={strings.communityFilterGenerationLabel}
              >
                <button
                  type="button"
                  data-facet="gen"
                  data-value=""
                  aria-pressed="true"
                >
                  {strings.communityFilterGenerationAll}
                </button>
                {generationOptions.map((option) => (
                  <button
                    type="button"
                    data-facet="gen"
                    data-value={option.code}
                    aria-pressed="false"
                  >
                    {option.label}
                  </button>
                ))}
              </div>
            </div>

            <div class="community__filter-group">
              <span class="community__filter-label">
                {strings.communityFilterActivityLabel}
              </span>
              <div
                class="community__pills"
                role="group"
                aria-label={strings.communityFilterActivityLabel}
              >
                <button
                  type="button"
                  data-facet="activity"
                  data-value=""
                  aria-pressed="true"
                >
                  {strings.communityFilterActivityAll}
                </button>
                {activityOptions.map((option) => (
                  <button
                    type="button"
                    data-facet="activity"
                    data-value={option.code}
                    aria-pressed="false"
                  >
                    {option.label}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <p
            class="community__count"
            data-community-count
            data-count-template={strings.communityCountTemplate}
            data-total={String(communities.length)}
            aria-live="polite"
          >
            {formatCount(
              strings.communityCountTemplate,
              communities.length,
              communities.length
            )}
          </p>

          <VehicleFitSummary locale={locale} fitments={fitmentTable.table} />

          <ul class="community__list" data-community-list>
            {orderedCommunities.map((community) => (
              <li
                class="entry"
                id={community.domId}
                data-regions={community.regions.join(" ")}
                data-languages={community.languages.join(" ")}
                data-gens={community.gens.join(" ")}
                data-activity={community.activity}
                data-fitment={fitmentTable.indexOf(community.fitment)}
              >
                <div class="entry__head">
                  <h2 class="entry__title">{community.title}</h2>
                  <div class="entry__head-meta">
                    {/*
                     * SHP-02 claimed badge — display-only, hidden at build and
                     * revealed by the client script only for an entry that
                     * carries a VERIFIED claim (the database filters on
                     * `verified_at is not null`, the same rule the graded
                     * `resolveClaimBadges` applies). An unverified claim, and a
                     * fortiori an unconfigured or unreachable stack, leaves the
                     * badge hidden — so an unverified claim changes nothing a
                     * reader sees, and the badge never affects order or
                     * inclusion (SHP-05).
                     */}
                    <span
                      class="entry__claimed"
                      data-community-claimed
                      data-entry-id={community.id}
                      hidden
                    >
                      {strings.communityClaimedBadge}
                    </span>
                    <span class="entry__type">{community.typeLabel}</span>
                  </div>
                </div>

                <p class="entry__summary">{community.summary}</p>

                <div class="entry__tags">
                  {community.regionLabels.map((label) => (
                    <span class="tag">{label}</span>
                  ))}
                  {community.languageLabels.map((label) => (
                    <span class="tag">{label}</span>
                  ))}
                  {community.genLabels.map((label) => (
                    <span class="tag tag--gen">{label}</span>
                  ))}
                </div>

                <p class="entry__activity">
                  <span
                    class="activity-badge"
                    data-activity={community.activity}
                  >
                    {community.activityLabel}
                  </span>
                  {/*
                   * T703a's F5 note, settled (it deferred this to T204). The
                   * raw `YYYY-MM-DD` was chosen because a localized *short*
                   * date is genuinely ambiguous — `08/09` is two different
                   * days depending on the reader. A localized *long* date is
                   * not: "28 de agosto de 2026" names the month in words and
                   * cannot be misread in either direction. The stored ISO
                   * value stays in `datetime`, so nothing machine-readable is
                   * lost and the figure is still stored exactly once.
                   */}
                  <time
                    class="entry__activity-date"
                    datetime={community.activityAssessed}
                  >
                    {strings.communityActivityAssessedTemplate.replace(
                      "{date}",
                      formatAssessed(community.activityAssessed)
                    )}
                  </time>
                </p>

                {community.goodFor.length > 0 && (
                  <div class="entry__good-for">
                    <span class="entry__label">
                      {strings.communityGoodForLabel}
                    </span>
                    <ul>
                      {community.goodFor.map((reason) => (
                        <li>{reason}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {community.showCaveat && (
                  <div class="entry__caveat">
                    {readingOrder.map((each, index) => (
                      <p
                        class:list={[
                          "caveat__line",
                          index === 0 && "caveat__line--primary",
                        ]}
                        lang={LOCALE_BCP47[each]}
                      >
                        {community.caveatByLocale[each]}
                      </p>
                    ))}
                  </div>
                )}

                <div class="entry__links">
                  <a
                    class="entry__visit"
                    href={community.url}
                    aria-label={`${strings.communityVisitLabel} ${community.title}`}
                  >
                    {strings.communityVisitLabel}
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d="M7 17 17 7" />
                      <path d="M9 7h8v8" />
                    </svg>
                  </a>
                  {community.links.length > 0 && (
                    <p class="entry__also-on">
                      <span class="entry__label">
                        {strings.communityAlsoOnLabel}
                      </span>
                      {community.links.map((link) => (
                        <a class="entry__link" href={link.url}>
                          {link.label}
                        </a>
                      ))}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>

          <p class="community__none" data-community-none hidden>
            {strings.communityNoResults}
          </p>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  import {
    EMPTY_COMMUNITY_FILTER,
    matchesCommunityFilter,
    type CommunityFilterState,
  } from "../../lib/community-filter";
  import { formatCount } from "../../lib/glossary-filter";
  import { buildTaxonomy } from "../../lib/fitment";
  import { readSelectorPayload } from "../../lib/vehicle-taxonomy";
  import { createVehicleListingView } from "../../lib/vehicle-listing";
  import {
    onVehicleSelectionChange,
    readVehicleSelection,
    type StoredVehicleSelection,
  } from "../../lib/vehicle-selection";
  import { readVerifiedClaimEntryIds } from "../../lib/supabase/directory";

  /**
   * Client-side filtering (T703a) and vehicle fitment (T204). Enhancement
   * only — see the glossary page's identical rationale: the toolbar is laid
   * out only when the document is marked script-capable, so a visitor with no
   * JavaScript sees the whole directory and no dead control. DOM wiring only;
   * `matchesCommunityFilter` (`src/lib/community-filter.ts`) owns the facet
   * rule, `src/lib/vehicle-listing.ts` owns the vehicle filter, and
   * `src/lib/fitment/` owns every fitment answer.
   */
  function enhance(root: HTMLElement): void {
    const toolbar = root.querySelector<HTMLElement>("[data-community-toolbar]");
    const count = root.querySelector<HTMLElement>("[data-community-count]");
    const none = root.querySelector<HTMLElement>("[data-community-none]");
    const cards = [...root.querySelectorAll<HTMLElement>(".entry")];
    if (!toolbar || !count || !none) return;

    const template = count.dataset.countTemplate ?? "";
    const total = Number(count.dataset.total ?? cards.length);
    const state: CommunityFilterState = { ...EMPTY_COMMUNITY_FILTER };

    const payload = readSelectorPayload(document);
    // The same nodes the selector shipped, read once. Without a selector on
    // the page there is no taxonomy and no vehicle filter — the facet pills
    // still work, and `buildTaxonomy([])` gives the generation facet its
    // "no expansion" reading rather than throwing.
    const taxonomy = buildTaxonomy(payload?.nodes ?? []);

    /*
     * The vehicle filter itself is `src/lib/vehicle-listing.ts`, shared with
     * the glossary and unit-tested against JSDOM — including the provisional
     * marker's text in both locales, which no real content entry currently
     * exercises (T204 review, F1). This page supplies the cards and the
     * taxonomy; it decides nothing about fitment.
     */
    const vehicle = createVehicleListingView({
      root,
      cards,
      taxonomy,
      lang: document.documentElement.lang,
    });

    function applyVehicle(selection: StoredVehicleSelection | null): void {
      vehicle?.apply(selection);
    }

    function apply(): void {
      let shown = 0;
      for (const card of cards) {
        const visible = matchesCommunityFilter(
          {
            regions: (card.dataset.regions ?? "").split(" ").filter(Boolean),
            languages: (card.dataset.languages ?? "")
              .split(" ")
              .filter(Boolean),
            gens: (card.dataset.gens ?? "").split(" ").filter(Boolean),
            activity: card.dataset.activity ?? "",
          },
          state,
          taxonomy
        );
        card.hidden = !visible;
        if (visible) shown += 1;
      }
      count!.textContent = formatCount(template, shown, total);
      none!.hidden = shown > 0;
      applyVehicle(readVehicleSelection(window));
    }

    const FACET_KEYS = ["region", "language", "gen", "activity"] as const;
    type FacetKey = (typeof FACET_KEYS)[number];
    function isFacetKey(value: string): value is FacetKey {
      return (FACET_KEYS as readonly string[]).includes(value);
    }

    const groups = new Map<FacetKey, HTMLButtonElement[]>();
    for (const button of toolbar.querySelectorAll<HTMLButtonElement>(
      "[data-facet]"
    )) {
      const facet = button.dataset.facet ?? "";
      if (!isFacetKey(facet)) continue;
      const list = groups.get(facet) ?? [];
      list.push(button);
      groups.set(facet, list);

      button.addEventListener("click", () => {
        const value = button.dataset.value ?? "";
        state[facet] = value;
        for (const sibling of groups.get(facet) ?? []) {
          sibling.setAttribute(
            "aria-pressed",
            String((sibling.dataset.value ?? "") === value)
          );
        }
        apply();
      });
    }

    // The selector lives in the site chrome and knows nothing about this
    // page; it announces, and the listing re-filters (FIT-03).
    onVehicleSelectionChange(window, (selection) => applyVehicle(selection));

    apply();
  }

  /**
   * SHP-02 claimed badges. Reveal, for each entry that carries a VERIFIED
   * claim, the badge the server rendered hidden. The verified-entry set comes
   * from the `directory_verified_claims()` RPC, which returns only the
   * `community_entry_id` of claims where `verified_at is not null` — so an
   * unverified claim contributes nothing, and an unconfigured or unreachable
   * stack (including an anonymous visitor, since the RPC is authenticated-only —
   * see `src/lib/supabase/directory.ts`) yields the empty set
   * (`readVerifiedClaimEntryIds` fails to no badge: absent is the safe, neutral
   * state for a display-only affordance). This never reorders or hides a card —
   * it only toggles a badge's visibility — so SHP-05 neutrality holds regardless
   * of what it finds.
   */
  async function revealClaimedBadges(root: HTMLElement): Promise<void> {
    const badges = [
      ...root.querySelectorAll<HTMLElement>("[data-community-claimed]"),
    ];
    if (badges.length === 0) return;
    const verified = await readVerifiedClaimEntryIds();
    for (const badge of badges) {
      const entryId = badge.dataset.entryId ?? "";
      if (entryId !== "" && verified.has(entryId)) badge.hidden = false;
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-community]"
  )) {
    enhance(root);
    void revealClaimedBadges(root);
  }
</script>

