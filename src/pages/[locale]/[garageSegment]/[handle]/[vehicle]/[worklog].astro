---
/**
 * A vehicle's public **work-log** page (T2-404b, SHR-02, SHR-03, SHR-04).
 *
 * > **SHR-02** … a work-log page … at a **stable public URL under their
 * > handle**, bilingual chrome, user content in whatever language the user
 * > wrote.
 * > **SHR-03** Costs and receipts SHALL stay private even on a public work-log
 * > unless opened per record.
 * > **SHR-04** Public pages SHALL carry the reference site's chrome and design
 * > (HANDOFF-DESIGN.md) and hreflang per 001 I18N-04.
 *
 * The work-log sibling of `[vehicle].astro`, at `…/{vehicleId}/{log|historial}/`
 * — one level deeper, in that locale's own word. Everything the showcase page's
 * doc comment says about the placeholder build, the `vercel.json` rewrite, and
 * the client link-rewrite applies here unchanged; what differs is the body: the
 * vehicle's header plus its published history.
 *
 * ## Costs and receipts (SHR-03), decided by the database and rendered as given
 *
 * The world reader returns a record only when the truck's `is_worklog_public`
 * and the record's `is_public` are both set, and it **omits the cost keys
 * entirely** from a record whose own `is_cost_public` is closed (SHR-06's
 * shape, one audience over) — so a record with no `cost_amount` key was one the
 * reader was not shown the cost of, and one carrying `cost_amount: null` is a
 * job with no figure recorded, and the two render differently. Receipts are
 * never returned to the world at all (`visibleReceipts` is `false` for the world
 * principal), so this page has no receipts surface. Nothing here re-derives any
 * of that: the DB is the enforcement boundary (SHR-01), mirrored in
 * `src/lib/garage/visibility.ts`, and this page renders what it is handed.
 *
 * refs specs/002-montero-garage (SHR-02, SHR-03, SHR-04, SHR-01, SHR-09,
 * GAR-02′, GAR-05′, MIG-03), specs/001-foundation (SCF-01, I18N-01, I18N-04,
 * I18N-08), specs/001-foundation/design/HANDOFF-DESIGN.md (Taller artboard)
 */
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import {
  LOCALE_BCP47,
  LOCALES,
  isLocale,
  type Locale,
} from "../../../../../i18n/routing";
import { COLLECTION_ROUTE_SEGMENTS } from "../../../../../i18n/routes";
import { generationLabel, t } from "../../../../../i18n/ui";
import { SITE_NAME } from "../../../../../site";
import { SUPABASE_BROWSER_CONFIG } from "../../../../../lib/supabase/config";
import {
  SHOWCASE_PLACEHOLDER_HANDLE,
  SHOWCASE_PLACEHOLDER_VEHICLE,
  WORKLOG_ROUTE_SEGMENTS,
  worklogRoutePaths,
} from "../../../../../lib/garage/showcase-view";
import {
  GENERATION_IDS,
  type GenerationId,
} from "../../../../../schemas/vehicles";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: {
      locale,
      garageSegment: COLLECTION_ROUTE_SEGMENTS.garage[locale],
      handle: SHOWCASE_PLACEHOLDER_HANDLE,
      vehicle: SHOWCASE_PLACEHOLDER_VEHICLE,
      worklog: WORKLOG_ROUTE_SEGMENTS[locale],
    },
  }));
}

const { locale: param } = Astro.params;
if (!isLocale(param)) {
  throw new Error(`Unknown locale segment: ${String(param)}`);
}
const locale: Locale = param;
const strings = t(locale);

const placeholderRoutes = worklogRoutePaths(
  SHOWCASE_PLACEHOLDER_HANDLE,
  SHOWCASE_PLACEHOLDER_VEHICLE
);

const configured = SUPABASE_BROWSER_CONFIG !== null;

const generationLabels = Object.fromEntries(
  GENERATION_IDS.map((id) => [id, generationLabel(strings, id as GenerationId)])
);
const generationLabelsJson = JSON.stringify(generationLabels).replaceAll(
  "<",
  "\\u003c"
);
---

<BaseLayout
  locale={locale}
  routePathByLocale={placeholderRoutes}
  title={`${strings.worklogPageTitle} — ${SITE_NAME}`}
  description={strings.worklogPageIntro}
>
  <section
    class="worklog"
    data-worklog
    data-generation-labels={generationLabelsJson}
    data-locale={LOCALE_BCP47[locale]}
    data-string-loading={strings.worklogPageLoading}
    data-string-not-found={strings.publicPageNotFound}
    data-string-error={strings.sharePageError}
    data-string-history-empty={strings.worklogPageHistoryEmpty}
    data-string-cost-none={strings.sharePageCostNone}
    data-string-showcase-link={strings.worklogPageShowcaseLink}
    data-string-kind-work={strings.garageRecordKindWork}
    data-string-kind-receipt={strings.garageRecordKindReceipt}
    data-string-kind-note={strings.garageRecordKindNote}
    data-string-kind-plan={strings.garageRecordKindPlan}
  >
    <div class="worklog__intro">
      <h1>{strings.worklogPageTitle}</h1>
      <p>{strings.worklogPageIntro}</p>
    </div>

    {
      configured ? (
        <div class="worklog__panel">
          <p
            class="worklog__message"
            data-worklog-message
            role="status"
            aria-live="polite"
          >
            {strings.worklogPageLoading}
          </p>

          <div class="worklog__body" data-worklog-body hidden>
            <div class="worklog__head">
              <p class="worklog__name" data-worklog-name />
              <p class="worklog__identity" data-worklog-identity />
              <p class="worklog__actions">
                <a class="worklog__link" data-worklog-showcase-link hidden>
                  {strings.worklogPageShowcaseLink}
                </a>
              </p>
            </div>

            <p class="worklog__fineprint">{strings.publicPageTestimonyNote}</p>

            <h2>{strings.worklogPageHistoryHeading}</h2>
            <p class="worklog__note" data-worklog-empty hidden>
              {strings.worklogPageHistoryEmpty}
            </p>
            <ol class="worklog__timeline" data-worklog-records />
          </div>

          <noscript>
            <p class="worklog__notice">{strings.publicPageScriptRequired}</p>
          </noscript>
        </div>
      ) : (
        <p class="worklog__notice">{strings.publicPageUnavailable}</p>
      )
    }
  </section>
</BaseLayout>

<script>
  import {
    isLocale,
    localeHref,
    type Locale,
  } from "../../../../../i18n/routing";
  import { SITE_NAME } from "../../../../../site";
  import {
    readPublicRecords,
    readPublicVehicle,
  } from "../../../../../lib/supabase/shares";
  import {
    applyResolvedShowcaseLinks,
    resolveShowcasePage,
    showcaseRoutePath,
    worklogRoutePaths,
    showcaseUrlParams,
    type PublicProfileDirectory,
  } from "../../../../../lib/garage/showcase-view";
  import {
    formatCost,
    formatDuration,
    formatRecordDate,
    recordHeadline,
    type RecordRow,
  } from "../../../../../lib/garage/record";
  import type { VehicleRow } from "../../../../../lib/garage/vehicle";
  import type { VisibleRecord } from "../../../../../lib/garage/visibility";

  /**
   * DOM wiring only — composes no prose, decides no visibility. The records
   * arrive already masked for the world by the database (SHR-01, SHR-03), the
   * publication gate is `resolveShowcasePage`'s, and every string is the
   * server's (I18N-08).
   */
  function enhance(root: HTMLElement): void {
    const message = root.querySelector<HTMLElement>("[data-worklog-message]");
    const body = root.querySelector<HTMLElement>("[data-worklog-body]");
    const name = root.querySelector<HTMLElement>("[data-worklog-name]");
    const identity = root.querySelector<HTMLElement>("[data-worklog-identity]");
    const empty = root.querySelector<HTMLElement>("[data-worklog-empty]");
    const timeline = root.querySelector<HTMLElement>("[data-worklog-records]");
    const showcaseLink = root.querySelector<HTMLAnchorElement>(
      "[data-worklog-showcase-link]"
    );
    if (
      !message ||
      !body ||
      !name ||
      !identity ||
      !empty ||
      !timeline ||
      !showcaseLink
    ) {
      return;
    }

    const text = { ...root.dataset };
    const localeTag = text.locale || "en";
    const locale: Locale = isLocale(localeTag.slice(0, 2))
      ? (localeTag.slice(0, 2) as Locale)
      : "en";

    const generationLabels: Record<string, string> = (() => {
      try {
        return JSON.parse(text.generationLabels ?? "{}") as Record<
          string,
          string
        >;
      } catch {
        return {};
      }
    })();

    function say(value: string): void {
      message!.textContent = value;
      message!.hidden = value === "";
    }

    function setNoindex(on: boolean): void {
      const existing = document.head.querySelector<HTMLMetaElement>(
        'meta[name="robots"]'
      );
      if (on) {
        const meta = existing ?? document.createElement("meta");
        meta.setAttribute("name", "robots");
        meta.setAttribute("content", "noindex, nofollow");
        if (!existing) document.head.append(meta);
      } else if (existing) {
        existing.remove();
      }
    }

    function identityLabel(vehicle: {
      readonly generation_id: string;
      readonly market_id: string | null;
      readonly model_year: number | null;
      readonly engine_id: string | null;
    }): string {
      return [
        generationLabels[vehicle.generation_id] ?? vehicle.generation_id,
        vehicle.market_id ? vehicle.market_id.toUpperCase() : "",
        vehicle.model_year === null ? "" : String(vehicle.model_year),
        vehicle.engine_id ? vehicle.engine_id.toUpperCase() : "",
      ]
        .filter((part) => part !== "")
        .join(" · ");
    }

    function kindLabel(kind: string): string {
      if (kind === "work") return text.stringKindWork ?? kind;
      if (kind === "receipt") return text.stringKindReceipt ?? kind;
      if (kind === "note") return text.stringKindNote ?? kind;
      if (kind === "plan") return text.stringKindPlan ?? kind;
      return kind;
    }

    /**
     * One record as a list item. The cost line is rendered whenever the
     * `cost_amount` key is present, and only then — the absent key is the
     * database saying "you were not shown this" (SHR-03/SHR-06), and a present
     * `null` is a job with no figure recorded. The same reading
     * `[shareSegment].astro` settled after its own review (F9).
     */
    function renderRecord(row: VisibleRecord): HTMLLIElement {
      const item = document.createElement("li");
      item.className = "worklog__record";

      const heading = document.createElement("p");
      heading.className = "worklog__record-title";
      heading.textContent = recordHeadline(
        row as Pick<RecordRow, "title" | "kind">,
        kindLabel(row.kind)
      );
      item.append(heading);

      const meta = document.createElement("p");
      meta.className = "worklog__record-meta";
      const parts: string[] = [formatRecordDate(row.occurred_on, locale)];
      if (row.odometer_km !== null && row.odometer_km !== undefined) {
        parts.push(
          new Intl.NumberFormat(locale, {
            style: "unit",
            unit: "kilometer",
            unitDisplay: "short",
            maximumFractionDigits: 0,
          }).format(row.odometer_km)
        );
      }
      if (row.time_minutes !== null && row.time_minutes !== undefined) {
        parts.push(formatDuration(row.time_minutes, locale));
      }
      // Punctuation, not prose.
      meta.textContent = parts.join(" · ");
      item.append(meta);

      if (Object.hasOwn(row, "cost_amount")) {
        const cost = document.createElement("p");
        cost.className = "worklog__record-cost";
        cost.textContent =
          typeof row.cost_amount === "number" &&
          typeof row.cost_currency === "string"
            ? formatCost(row.cost_amount, row.cost_currency, locale)
            : (text.stringCostNone ?? "");
        item.append(cost);
      }

      const note = (row.body ?? "").trim();
      if (note !== "") {
        const prose = document.createElement("p");
        prose.className = "worklog__record-body";
        prose.textContent = note;
        item.append(prose);
      }
      return item;
    }

    async function open(): Promise<void> {
      const params = showcaseUrlParams(window.location.pathname);
      if (params === null) {
        setNoindex(true);
        say(text.stringNotFound ?? "");
        return;
      }
      say(text.stringLoading ?? "");

      const vehicleResult = await readPublicVehicle(params);
      if (!vehicleResult.ok) {
        if (vehicleResult.reason === "refused") setNoindex(true);
        say(
          vehicleResult.reason === "refused"
            ? (text.stringNotFound ?? "")
            : (text.stringError ?? "")
        );
        return;
      }
      if (vehicleResult.value === null) {
        setNoindex(true);
        say(text.stringNotFound ?? "");
        return;
      }

      const vehicle: VehicleRow = {
        ...vehicleResult.value,
        owner_id: "",
        photo_paths: [],
        cover_photo_path: null,
      };
      const profile: PublicProfileDirectory = {
        handle: params.handle,
        retiredHandles: [],
        vehicles: [vehicle],
      };
      const resolution = resolveShowcasePage({
        profiles: [profile],
        records: [],
        handle: params.handle,
        vehicleId: params.vehicleId,
        page: "worklog",
      });
      if (!resolution.ok || resolution.page !== "worklog") {
        setNoindex(true);
        say(text.stringNotFound ?? "");
        return;
      }

      setNoindex(false);
      const resolved = resolution.vehicle;

      name!.textContent = resolved.display_name;
      name!.setAttribute("role", "heading");
      name!.setAttribute("aria-level", "2");
      identity!.textContent = identityLabel(resolved);
      // The client override of the server-rendered `<title>` uses the same
      // single brand source `src/site.ts` owns (002 MIG-01), so a rename lands
      // here too and never diverges from the `${...} — ${SITE_NAME}` the
      // frontmatter emitted.
      document.title = `${resolved.display_name} — ${SITE_NAME}`;

      if (resolved.is_showcase_public) {
        showcaseLink!.href = localeHref(
          locale,
          showcaseRoutePath(params.handle, params.vehicleId, locale)
        );
        showcaseLink!.hidden = false;
      } else {
        showcaseLink!.hidden = true;
      }

      applyResolvedShowcaseLinks({
        doc: document,
        routes: worklogRoutePaths(params.handle, params.vehicleId),
        locale,
      });

      // The records, already world-masked by the database. A failed fetch is
      // not an empty history (AGENTS.md): the body opens only after a genuine
      // answer, and a failure is said as one.
      const history = await readPublicRecords(params);
      if (!history.ok) {
        if (history.reason === "refused") setNoindex(true);
        say(
          history.reason === "refused"
            ? (text.stringNotFound ?? "")
            : (text.stringError ?? "")
        );
        return;
      }

      timeline!.replaceChildren(
        ...history.value.map((row) => renderRecord(row))
      );
      empty!.hidden = history.value.length > 0;

      body!.hidden = false;
      say("");
    }

    void open().catch(() => say(text.stringError ?? ""));
  }

  const root = document.querySelector<HTMLElement>("[data-worklog]");
  if (root) enhance(root);
</script>

<style>
  .worklog {
    --paper: #f7f4ee;
    --panel: #ffffff;
    --ink: #2b2620;
    --muted: #6e6559;
    --line: #e4ddd1;
    --rust: #b0532a;
    --rust-deep: #93441f;

    font-family: Archivo, "Helvetica Neue", Arial, sans-serif;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 42rem;
  }

  .worklog [hidden] {
    display: none !important;
  }

  .worklog__intro,
  .worklog__panel,
  .worklog__body,
  .worklog__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .worklog__intro h1 {
    margin: 0;
    font-size: 1.875rem;
    font-weight: 800;
    letter-spacing: -0.3px;
  }

  .worklog__intro p,
  .worklog__body h2,
  .worklog__head p {
    margin: 0;
  }

  .worklog__name {
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.2px;
  }

  .worklog__identity {
    color: var(--muted);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.9375rem;
  }

  .worklog__notice,
  .worklog__note,
  .worklog__fineprint,
  .worklog__message {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .worklog__actions {
    margin: 0;
  }

  .worklog__link {
    color: var(--rust);
    font-weight: 600;
    text-decoration: none;
  }

  .worklog__link:hover {
    color: var(--rust-deep);
    text-decoration: underline;
  }

  .worklog__timeline {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .worklog__record {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    padding: 0.75rem;
  }

  .worklog__record-title {
    margin: 0;
    font-weight: 700;
  }

  .worklog__record-meta,
  .worklog__record-cost,
  .worklog__record-body {
    margin: 0.25rem 0 0;
  }

  .worklog__record-meta {
    color: var(--muted);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.875rem;
  }
</style>
