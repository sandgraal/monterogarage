                    data-garage-receipt-message
                    role="status"
                    aria-live="polite"
                  />
                </div>
              </div>

              {/* ------------------------------------------------------ */}
              {/* Media attachments (GAR-06′)                             */}
              {/* ------------------------------------------------------ */}
              {/*
               * Alongside receipts and deliberately not inside them. GAR-06′
               * says an attachment is "independent of a receipt's
               * vendor/date/amount fields", and a section sharing the receipts
               * form's four typed inputs would make the WhatsApp voice note
               * that motivated the requirement impossible to file without
               * inventing a vendor. The visual distinction is the point of the
               * `--media` modifier: same shell, no financial fields, its own
               * heading, and a hint saying what belongs here instead.
               */}
              <div class="garage__receipts garage__receipts--media">
                <h3>{strings.garageMediaHeading}</h3>
                <p class="garage__fineprint">
                  {strings.garageMediaPrivateNote}
                </p>

                <p class="garage__empty-note" data-garage-media-need-record>
                  {strings.garageMediaNeedRecord}
                </p>

                <ul class="garage__media-list" data-garage-media-list />
                <p class="garage__empty-note" data-garage-media-empty hidden>
                  {strings.garageMediaEmpty}
                </p>

                <div class="garage__receipt-form" data-garage-media-form hidden>
                  <p class="garage__field">
                    <label class="garage__label" for="garage-media-file">
                      {strings.garageMediaFileLabel}
                    </label>
                    <input
                      class="garage__file"
                      id="garage-media-file"
                      type="file"
                      accept={MEDIA_ACCEPT_TYPES.join(",")}
                      aria-describedby="garage-media-hint"
                      data-garage-media-file
                    />
                    <span class="garage__hint" id="garage-media-hint">
                      {strings.garageMediaHint}
                    </span>
                  </p>

                  <div class="garage__actions">
                    <button
                      class="garage__button garage__button--alt"
                      type="button"
                      data-garage-media-attach
                    >
                      {strings.garageMediaAttach}
                    </button>
                  </div>
                  <p
                    class="garage__message"
                    data-garage-media-message
                    role="status"
                    aria-live="polite"
                  />
                </div>
              </div>

              <p
                class="garage__message"
                data-garage-record-message
                role="alert"
              />

              <div class="garage__actions">
                <button
                  class="garage__button"
                  type="submit"
                  data-garage-record-save
                  data-idle={strings.garageRecordSave}
                >
                  {strings.garageRecordSave}
                </button>
                <button
                  class="garage__button garage__button--alt"
                  type="button"
                  data-garage-record-cancel
                >
                  {strings.garageCancel}
                </button>
                <button
                  class="garage__link garage__link--danger"
                  type="button"
                  data-garage-record-delete
                  hidden
                >
                  {strings.garageRecordDelete}
                </button>
              </div>
            </form>

            <p
              class="garage__message"
              data-garage-message
              role="status"
              aria-live="polite"
            />

            {/* ---------------------------------------------------------- */}
            {/* Templates: markup the script clones, text the server wrote  */}
            {/* ---------------------------------------------------------- */}
            <template data-garage-row-template>
              <li class="garage__row">
                <div class="garage__row-text">
                  <span class="garage__row-name" data-row-name />
                  <span class="garage__row-identity" data-row-identity />
