                  <button class="garage__button" type="button" data-row-open>
                    {strings.garageOpenVehicle}
                  </button>
                </div>
              </li>
            </template>

            <template data-garage-photo-template>
              <li class="garage__photo">
                <img class="garage__photo-image" data-photo-image alt="" />
                <button
                  class="garage__link garage__link--danger"
                  type="button"
                  data-photo-remove
                >
                  {strings.garagePhotoRemove}
                </button>
              </li>
            </template>

            {/*
             * One entry on the rail: the dot, the `date · odometer` meta line,
             * and the card — the Taller artboard's timeline, element for
             * element. Done and planned differ by a class on the item, set by
             * the script from `kind`, so the two states share one template and
             * cannot drift apart.
             */}
            <template data-garage-entry-template>
              <li class="garage__entry">
                <span class="garage__entry-dot" aria-hidden="true" />
                <span class="garage__entry-meta" data-entry-meta />
                <div class="garage__card">
                  <div class="garage__card-head">
                    <strong class="garage__card-title" data-entry-title />
                    <span class="garage__badge" data-entry-badge />
