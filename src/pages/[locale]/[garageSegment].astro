      mediaTemplate: query<HTMLTemplateElement>("[data-garage-media-template]"),
      mediaList: query<HTMLUListElement>("[data-garage-media-list]"),
      mediaEmpty: query<HTMLElement>("[data-garage-media-empty]"),
      mediaNeedRecord: query<HTMLElement>("[data-garage-media-need-record]"),
      mediaForm: query<HTMLElement>("[data-garage-media-form]"),
      mediaFile: query<HTMLInputElement>("[data-garage-media-file]"),
      mediaAttach: query<HTMLButtonElement>("[data-garage-media-attach]"),
      mediaMessage: query<HTMLElement>("[data-garage-media-message]"),
      /* Publishing — T2-402, SHR-02 / SHR-03 */
      handleCurrent: query<HTMLElement>("[data-garage-handle-current]"),
      handleInput: query<HTMLInputElement>("[data-garage-handle-input]"),
      handleSave: query<HTMLButtonElement>("[data-garage-handle-save]"),
      handleMessage: query<HTMLElement>("[data-garage-handle-message]"),
      visibilityGate: query<HTMLElement>("[data-garage-visibility-gate]"),
      showcasePublic: query<HTMLInputElement>("[data-garage-showcase-public]"),
      worklogPublic: query<HTMLInputElement>("[data-garage-worklog-public]"),
      visibilityMessage: query<HTMLElement>("[data-garage-visibility-message]"),
      recordVisibility: query<HTMLElement>("[data-garage-record-visibility]"),
      recordVisibilityGate: query<HTMLElement>(
