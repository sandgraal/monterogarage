---
/**
 * The garage — a user's vehicles and their profiles (T2-301, GAR-01′).
 *
 * > **GAR-01′** A user SHALL create vehicle profiles with a display name,
 * > taxonomy identity resolved by the 001 fitment engine, photos, and
 * > odometer.
 *
 * `/en/garage/` and `/es/taller/` are built from this one file by the same
 * `getStaticPaths` seam the glossary, community and sign-in pages use. The ES
 * segment is `taller`, which is the glossary's ruling rather than a
 * preference — see `src/i18n/routes.ts`.
 *
 * ## Static shell, user data in the browser
 *
 * This is a statically built site and the content of this page is one person's
 * private rows. So the server renders the *shell* — every word, in this
 * locale, laid out and styled — and the browser fills it from Supabase after
 * the session is known. Nothing user-specific is ever in `dist/`.
 *
 * That gives the page four states, and it renders all four honestly:
 *
 * | state | what the reader gets |
 * |---|---|
 * | no project configured at build | a notice saying accounts are not on here |
 * | no JavaScript | the sign-in prompt and an explanation |
 * | signed out | the sign-in prompt, never an error |
 * | signed in | the garage |
 *
 * The signed-out prompt is what a visitor gets *by default*, because with no
 * script we cannot know better and a wrong guess must fail toward "here is how
 * to sign in". Once scripting is available, `html.js` (set by `BaseLayout`
 * before first paint) swaps the default to a "opening your garage" line, so a
 * signed-in reader is never told they are signed out while the session
 * resolves. Same CSS-not-`hidden` reasoning as the vehicle selector: revealing
 * a block after hydration is a layout shift against SCF-06.
 *
 * ## Every string is the server's
 *
 * The script below composes no prose. Templates and messages are handed to it
 * through `data-string-*` attributes and `<template>` elements the server
 * already localized (I18N-08) — the same pattern `[authSegment].astro`
 * established. The two figures that appear inside sentences (the display-name
 * limit, the photo size limit) are interpolated here from their constants, so
 * neither is written down in a locale (AGENTS.md).
 *
 * ## The fitment engine, not a second copy of it
 *
 * The identity controls are filled from `createVehicleOptions` reading the
 * taxonomy payload `VehicleSelector.astro` already inlines on every page —
 * the same module, the same data, no second request and no forked narrowing
 * logic. "Could this combination have existed" is asked of `src/lib/fitment/`
 * and nowhere else (FIT-01).
 *
 * refs specs/002-montero-garage (GAR-01′, ACC-02, SHR-01, MIG-03),
 * specs/001-foundation (FIT-01, FIT-03, I18N-01, I18N-08),
 * specs/001-foundation/design/HANDOFF-DESIGN.md (Taller artboard)
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  LOCALE_BCP47,
  isLocale,
  localeHref,
  type Locale,
} from "../../i18n/routing";
import {
  collectionRouteParams,
  collectionRoutePath,
  collectionRoutePaths,
} from "../../i18n/routes";
import { generationLabel, t } from "../../i18n/ui";
import { SITE_NAME, TRUCK_NAME } from "../../site";
import { SUPABASE_BROWSER_CONFIG } from "../../lib/supabase/config";
import { MAX_DISPLAY_NAME_LENGTH } from "../../lib/garage/vehicle";
import { MAX_PHOTO_BYTES, PHOTO_MIME_TYPES } from "../../lib/garage/photos";
import { HANDLE_LENGTH } from "../../lib/garage/handles";
import {
  MAX_RECEIPT_BYTES,
  RECEIPT_MIME_TYPES,
} from "../../lib/garage/receipt";
import {
  MAX_MEDIA_BYTES,
  MEDIA_ACCEPT_TYPES,
} from "../../lib/garage/record-media";
import {
  MAX_RECORD_BODY_LENGTH,
  MAX_RECORD_TITLE_LENGTH,
  RECORD_CURRENCIES,
  RECORD_KINDS,
  type ReferenceCatalogue,
  type ReferenceOption,
} from "../../lib/garage/record";
import { GENERATION_IDS, type GenerationId } from "../../schemas/vehicles";

export function getStaticPaths() {
  return collectionRouteParams("garage", "garageSegment");
}

const { locale: param } = Astro.params;
if (!isLocale(param)) {
  throw new Error(`Unknown locale segment: ${String(param)}`);
}
const locale: Locale = param;
const strings = t(locale);
const routes = collectionRoutePaths("garage");
const configured = SUPABASE_BROWSER_CONFIG !== null;
const signInHref = localeHref(locale, collectionRoutePath("signIn", locale));

/**
 * The two figures that appear inside a sentence, formatted once here.
 *
 * `MAX_PHOTO_BYTES` is bytes in code and megabytes to a person, and `Intl`
 * knows the unit's name in both locales — so the sentence carries `{size}` and
 * this fills it, rather than "10 MB" being typed into two locale records.
 */
const maxPhotoSize = new Intl.NumberFormat(LOCALE_BCP47[locale], {
  style: "unit",
  unit: "megabyte",
  unitDisplay: "short",
  maximumFractionDigits: 0,
}).format(MAX_PHOTO_BYTES / 1024 / 1024);

const nameTooLong = strings.garageIssueNameTooLongTemplate.replace(
  "{max}",
  new Intl.NumberFormat(LOCALE_BCP47[locale]).format(MAX_DISPLAY_NAME_LENGTH)
);
const photoTooLarge = strings.garagePhotoSizeRejectedTemplate.replace(
  "{size}",
  maxPhotoSize
);

/**
 * The generation options, server-rendered.
 *
 * A `<select>` rather than the selector's button row: this is a form field
 * inside a form of six, not the site chrome's headline control, and it sits in
 * the same column as market/year/engine. The labels are the same
 * `generation.*` strings T204 uses — one translation of "Gen 3", not two.
 */
const generationOptions = GENERATION_IDS.map((id) => ({
  id,
  label: generationLabel(strings, id as GenerationId),
}));

/**
 * The record form's other three interpolated figures, formatted here for the
 * same reason as the two above: a limit is a number, and a number never gets
 * typed into a locale record (AGENTS.md).
 */
const number = new Intl.NumberFormat(LOCALE_BCP47[locale]);
const titleTooLong = strings.garageRecordIssueTitleLongTemplate.replace(
  "{max}",
  number.format(MAX_RECORD_TITLE_LENGTH)
);
const notesTooLong = strings.garageRecordIssueNotesLongTemplate.replace(
  "{max}",
  number.format(MAX_RECORD_BODY_LENGTH)
);
const receiptTooLarge = strings.garageReceiptSizeRejectedTemplate.replace(
  "{size}",
  new Intl.NumberFormat(LOCALE_BCP47[locale], {
    style: "unit",
    unit: "megabyte",
    unitDisplay: "short",
    maximumFractionDigits: 0,
  }).format(MAX_RECEIPT_BYTES / 1024 / 1024)
);
const mediaTooLarge = strings.garageMediaSizeRejectedTemplate.replace(
  "{size}",
  new Intl.NumberFormat(LOCALE_BCP47[locale], {
    style: "unit",
    unit: "megabyte",
    unitDisplay: "short",
    maximumFractionDigits: 0,
  }).format(MAX_MEDIA_BYTES / 1024 / 1024)
);

/**
 * The handle rules, as sentences (SHR-02).
 *
 * `HANDLE_LENGTH` is one constant read by the form, by
 * `src/lib/garage/handles.ts` and by the migration's check constraint, so the
 * bounds appear in a sentence here and are typed into a locale record nowhere
 * (AGENTS.md — "if you find yourself writing the same figure twice, the schema
 * is wrong").
 */
const handleHint = strings.garageHandleHintTemplate
  .replace("{min}", number.format(HANDLE_LENGTH.min))
  .replace("{max}", number.format(HANDLE_LENGTH.max));
const handleTooShort = strings.garageHandleIssueShortTemplate.replace(
  "{min}",
  number.format(HANDLE_LENGTH.min)
);
const handleTooLong = strings.garageHandleIssueLongTemplate.replace(
  "{max}",
  number.format(HANDLE_LENGTH.max)
);

/** The four `record_kind` values with the reader's name for each. */
const kindOptions = RECORD_KINDS.map((id) => ({
  id,
  label: {
    work: strings.garageRecordKindWork,
    receipt: strings.garageRecordKindReceipt,
    note: strings.garageRecordKindNote,
    plan: strings.garageRecordKindPlan,
  }[id],
}));

/**
 * What a record may point at (GAR-02′), read from the built content at build
 * time.
 *
 * This is the "validated against built content at render time" half of the
 * typed-references decision argued in `src/lib/garage/record.ts`: the ids live
 * in the record's own `text[]` columns, and the *names* behind them come from
 * the reference collections — so nothing was added to a content schema, and no
 * id can be chosen that the site does not ship.
 *
 * `prose[locale].title` is the entry's own localized title, which is why this
 * is built per page rather than shared: `/en/garage/` offers English titles and
 * `/es/taller/` Spanish ones, from the same ids (I18N-01, I18N-06).
 *
 * All three collections are empty today — their pages are 001's T4xx/T5xx — so
 * this ships as `{"problem":[],"part":[],"procedure":[]}`, the picker says so
 * in the reader's language, and `astro build` prints its own "does not exist
 * or is empty" warning per collection. That warning is Astro's, it is a
 * warning and not an error, and it goes away with the first entry; the
 * alternative was reading the content through something other than the
 * content API to keep a log quiet. When entries arrive the picker fills itself with
 * no change here. When their *pages* arrive, the chips a card renders become
 * links; they are deliberately not links yet, because a chip pointing at a page
 * that does not exist is a broken link `check:links` would be right to fail.
 */
const collator = new Intl.Collator(LOCALE_BCP47[locale], {
  sensitivity: "base",
});

/**
 * One collection as pickable options: `{ id, title }`, sorted by the reader's
 * own collation so the list is scannable, and by id after that so two builds
 * of the same content produce byte-identical markup.
 */
async function referenceOptions(
  collection: "problems" | "parts" | "procedures"
): Promise<ReferenceOption[]> {
  const entries = await getCollection(collection);
  return entries
    .map((entry) => ({ id: entry.id, title: entry.data.prose[locale].title }))
    .sort(
      (left, right) =>
        collator.compare(left.title, right.title) ||
        left.id.localeCompare(right.id)
    );
}

const referenceCatalogue: ReferenceCatalogue = {
  problem: await referenceOptions("problems"),
  part: await referenceOptions("parts"),
  procedure: await referenceOptions("procedures"),
};
/**
 * `<` is escaped so no title in the payload can close the `<script>` early —
 * `JSON.stringify` alone does not do it, because legal JSON inside an HTML
 * `<script>` element is not the same grammar. The same note
 * `VehicleSelector.astro` carries over the same one-line defence.
 */
const referenceCatalogueJson = JSON.stringify(referenceCatalogue).replaceAll(
  "<",
  "\\u003c"
);
const hasReferences = Object.values(referenceCatalogue).some(
  (options) => options.length > 0
);
---

<BaseLayout
  locale={locale}
  routePathByLocale={routes}
  title={`${strings.garageHeading} — ${SITE_NAME}`}
  description={strings.garageIntro}
>
  <section
    class="garage"
    data-garage
    data-garage-state="boot"
    data-string-error={strings.garageError}
    data-string-unreachable={strings.garageUnreachable}
    data-string-saving={strings.garageSaving}
    data-string-saved={strings.garageSaved}
    data-string-deleting={strings.garageDeleting}
    data-string-delete-confirm={strings.garageDeleteConfirmTemplate}
    data-string-uploading={strings.garagePhotosUploading}
    data-string-photo-alt={strings.garagePhotoAltTemplate}
    data-string-photo-type={strings.garagePhotoTypeRejected}
    data-string-photo-size={photoTooLarge}
    data-string-form-new={strings.garageFormNewHeading}
    data-string-form-edit={strings.garageFormEditHeading}
    data-string-issue-name-required={strings.garageIssueNameRequired}
    data-string-issue-name-long={nameTooLong}
    data-string-issue-generation={strings.garageIssueGenerationRequired}
    data-string-issue-identity={strings.garageIssueIdentityUnknown}
    data-string-issue-year={strings.garageIssueYearRange}
    data-string-issue-odometer={strings.garageIssueOdometerNumber}
    data-string-issue-odometer-large={strings.garageIssueOdometerLarge}
    data-string-facet-unknown={strings.garageFacetUnknown}
    data-string-no-engines={strings.vehicleSelectorNoEngines}
    data-string-engines-recorded={strings.vehicleSelectorEnginesRecorded}
    data-string-engines-unrecorded={strings.vehicleSelectorEnginesUnrecorded}
    data-string-browsing={strings.garageUsedForBrowsing}
    data-string-identity-incomplete={strings.garageIdentityIncomplete}
    data-string-unrecorded={strings.garageStatUnrecorded}
    data-string-record-form-new={strings.garageRecordNewHeading}
    data-string-record-form-edit={strings.garageRecordEditHeading}
    data-string-record-delete-confirm={strings.garageRecordDeleteConfirmTemplate}
    data-string-status-done={strings.garageStatusDone}
    data-string-status-planned={strings.garageStatusPlanned}
    data-string-chip-time={strings.garageChipTimeLabel}
    data-string-chip-cost={strings.garageChipCostLabel}
    data-string-chip-odometer={strings.garageChipOdometerLabel}
    data-string-chip-receipts={strings.garageChipReceiptsLabel}
    data-string-ref-problem={strings.garageReferenceProblemTemplate}
    data-string-ref-part={strings.garageReferencePartTemplate}
    data-string-ref-procedure={strings.garageReferenceProcedureTemplate}
    data-string-ref-unresolved={strings.garageReferenceUnresolved}
    data-string-record-issue-date={strings.garageRecordIssueDate}
    data-string-record-issue-date-range={strings.garageRecordIssueDateRange}
    data-string-record-issue-kind={strings.garageRecordIssueKind}
    data-string-record-issue-title={strings.garageRecordIssueTitleRequired}
    data-string-record-issue-title-long={titleTooLong}
    data-string-record-issue-notes-long={notesTooLong}
    data-string-record-issue-cost={strings.garageRecordIssueCost}
    data-string-record-issue-cost-separator={strings.garageRecordIssueCostSeparator}
    data-string-record-issue-cost-large={strings.garageRecordIssueCostLarge}
    data-string-record-issue-time={strings.garageRecordIssueTime}
    data-string-record-issue-time-large={strings.garageRecordIssueTimeLarge}
    data-string-record-issue-references={strings.garageRecordIssueReferences}
    data-string-receipt-uploading={strings.garageReceiptUploading}
    data-string-receipt-type={strings.garageReceiptTypeRejected}
    data-string-receipt-size={receiptTooLarge}
    data-string-receipt-remove-confirm={strings.garageReceiptRemoveConfirm}
    data-string-receipt-vendor-long={strings.garageReceiptIssueVendorLong}
    data-string-receipt-issue-date={strings.garageReceiptIssueDate}
    data-string-receipt-untitled={strings.garageReceiptUntitled}
    data-string-receipt-counts-unavailable={strings.garageReceiptCountsUnavailable}
    data-string-media-uploading={strings.garageMediaUploading}
    data-string-media-type={strings.garageMediaTypeRejected}
    data-string-media-size={mediaTooLarge}
    data-string-media-remove-confirm={strings.garageMediaRemoveConfirm}
    data-string-media-label-photo={strings.garageMediaLabelPhotoTemplate}
    data-string-media-label-video={strings.garageMediaLabelVideoTemplate}
    data-string-media-label-audio={strings.garageMediaLabelAudioTemplate}
    data-string-current-odometer-unknown={strings.garageCurrentOdometerUnknown}
    data-string-current-odometer-on={strings.garageCurrentOdometerOnTemplate}
    data-string-service-last={strings.garageCurrentServiceLastTemplate}
    data-string-service-since={strings.garageCurrentServiceSinceTemplate}
    data-string-service-since-unknown={strings.garageCurrentServiceSinceUnknown}
    data-string-open-overdue={strings.garageCurrentOpenOverdueTemplate}
    data-string-open-upcoming={strings.garageCurrentOpenUpcomingTemplate}
    data-string-estimate-time={strings.garagePlannedEstimateTimeLabel}
    data-string-estimate-cost={strings.garagePlannedEstimateCostLabel}
    data-string-estimate-coverage={strings.garagePlannedEstimateCoverageTemplate}
    data-string-handle-none={strings.garageHandleNone}
    data-string-handle-current={strings.garageHandleCurrentTemplate}
    data-string-handle-empty={strings.garageHandleIssueEmpty}
    data-string-handle-short={handleTooShort}
    data-string-handle-long={handleTooLong}
    data-string-handle-characters={strings.garageHandleIssueCharacters}
    data-string-handle-reserved={strings.garageHandleIssueReserved}
    data-string-handle-unavailable={strings.garageHandleUnavailable}
    data-string-visibility-needs-handle={strings.garageVisibilityNeedsHandle}
    data-locale={LOCALE_BCP47[locale]}
  >
    <div class="garage__intro">
      <h1>{strings.garageHeading}</h1>
      <p>{strings.garageIntro}</p>
    </div>

    {
      configured ? (
        <Fragment>
          {/*
           * Present from the first paint when scripting is available, so the
           * signed-out prompt below is never shown to a reader who does in
           * fact have a session.
           */}
          <p
            class="garage__boot"
            data-garage-boot
            role="status"
            aria-live="polite"
          >
            {strings.garageLoading}
          </p>

          <div class="garage__gate" data-garage-gate>
            <h2>{strings.garageSignedOutHeading}</h2>
            <p>{strings.garageSignedOutBody}</p>
            <p>
              <a class="garage__cta" href={signInHref}>
                {strings.garageSignInLink}
              </a>
            </p>
            <noscript>
              <p class="garage__notice">{strings.garageScriptRequired}</p>
            </noscript>
          </div>

          <div class="garage__app" data-garage-app hidden>
            {/* ---------------------------------------------------------- */}
            {/* The list of vehicles                                       */}
            {/* ---------------------------------------------------------- */}
            <div class="garage__panel" data-garage-list-view>
              {/* ------------------------------------------------------ */}
              {/* The public address (T2-402, SHR-02)                     */}
              {/*                                                        */}
              {/* On the list screen and not on a vehicle, because the    */}
              {/* handle belongs to the account: one address, however many */}
              {/* trucks are published under it. Every rule it can break  */}
              {/* is checked here for the reader's sake and enforced in   */}
              {/* the database for everyone else's (SHR-01 — a check in   */}
              {/* page code is not an enforcement mode).                  */}
              {/* ------------------------------------------------------ */}
              <section class="garage__handle">
                <h2>{strings.garageHandleHeading}</h2>
                <p class="garage__fineprint">{strings.garageHandleIntro}</p>
                <p class="garage__note" data-garage-handle-current>
                  {strings.garageHandleNone}
                </p>

                <p class="garage__field">
                  <label class="garage__label" for="garage-handle">
                    {strings.garageHandleLabel}
                  </label>
                  <input
                    class="garage__input"
                    id="garage-handle"
                    type="text"
                    autocomplete="off"
                    autocapitalize="none"
                    spellcheck="false"
                    maxlength={HANDLE_LENGTH.max}
                    aria-describedby="garage-handle-hint"
                    data-garage-handle-input
                  />
                  <span class="garage__hint" id="garage-handle-hint">
                    {handleHint}
                  </span>
                </p>

                <div class="garage__actions">
                  <button
                    class="garage__button"
                    type="button"
                    data-garage-handle-save
                    data-idle={strings.garageHandleSave}
                  >
                    {strings.garageHandleSave}
                  </button>
                </div>
                <p
                  class="garage__message"
                  data-garage-handle-message
                  role="alert"
                />
              </section>

              <div class="garage__panel-head">
                <h2>{strings.garageVehiclesHeading}</h2>
                <button class="garage__button" type="button" data-garage-add>
                  {strings.garageAddVehicle}
                </button>
              </div>

              <p class="garage__empty" data-garage-empty hidden>
                <strong>{strings.garageEmptyHeading}</strong>
                <span>{strings.garageEmptyBody}</span>
              </p>

              <ul class="garage__list" data-garage-list />
            </div>

            {/* ---------------------------------------------------------- */}
            {/* One vehicle: the Taller artboard's dashboard shell          */}
            {/* ---------------------------------------------------------- */}
            <div class="garage__panel" data-garage-detail-view hidden>
              <p>
                <button class="garage__link" type="button" data-garage-back>
                  {strings.garageBackToVehicles}
                </button>
              </p>

              <div class="garage__detail-head">
                <p class="garage__detail-name" data-garage-detail-name />
                <p class="garage__identity" data-garage-detail-identity />
              </div>

              <dl class="garage__stats">
                <div class="garage__stat">
                  <dt>{strings.garageOdometerLabel}</dt>
                  <dd data-garage-stat-odometer />
                </div>
                <div class="garage__stat">
                  <dt>{strings.garageStatEntries}</dt>
                  <dd data-garage-stat-entries />
                </div>
                <div class="garage__stat">
                  <dt>{strings.garageStatPlanned}</dt>
                  <dd data-garage-stat-planned />
                </div>
              </dl>

              <div class="garage__actions">
                <button class="garage__button" type="button" data-garage-edit>
                  {strings.garageEditVehicle}
                </button>
                <button
                  class="garage__button garage__button--alt"
                  type="button"
                  data-garage-browse
                >
                  {strings.garageUseForBrowsing}
                </button>
              </div>
              <p
                class="garage__note"
                data-garage-browse-note
                role="status"
                aria-live="polite"
              />

              {/* ------------------------------------------------------ */}
              {/* Who can see this truck (T2-402, SHR-02)                 */}
              {/*                                                        */}
              {/* Two switches and not one: SHR-02 names the showcase and */}
              {/* the work-log separately, and publishing a photo gallery */}
              {/* is not publishing a maintenance history with dates,     */}
              {/* odometer readings and a home town in the vendor names.  */}
              {/* Checkboxes rather than a save button, because the state */}
              {/* IS the decision — a toggle that needed confirming is a  */}
              {/* toggle somebody leaves half-thrown.                     */}
              {/* ------------------------------------------------------ */}
              <div class="garage__visibility">
                <h3>{strings.garageVisibilityHeading}</h3>
                <p class="garage__fineprint">{strings.garageVisibilityIntro}</p>
                <p class="garage__note" data-garage-visibility-gate hidden>
                  {strings.garageVisibilityNeedsHandle}
                </p>

                <p class="garage__check">
                  <input
                    class="garage__checkbox"
                    id="garage-showcase-public"
                    type="checkbox"
                    aria-describedby="garage-showcase-hint"
                    data-garage-showcase-public
                  />
                  <label class="garage__label" for="garage-showcase-public">
                    {strings.garageVisibilityShowcaseLabel}
                  </label>
                  <span class="garage__hint" id="garage-showcase-hint">
                    {strings.garageVisibilityShowcaseHint}
                  </span>
                </p>

                <p class="garage__check">
                  <input
                    class="garage__checkbox"
                    id="garage-worklog-public"
                    type="checkbox"
                    aria-describedby="garage-worklog-hint"
                    data-garage-worklog-public
                  />
                  <label class="garage__label" for="garage-worklog-public">
                    {strings.garageVisibilityWorklogLabel}
                  </label>
                  <span class="garage__hint" id="garage-worklog-hint">
                    {strings.garageVisibilityWorklogHint}
                  </span>
                </p>

                <p
                  class="garage__message"
                  data-garage-visibility-message
                  role="status"
                  aria-live="polite"
                />
              </div>

              {/*
               * Whatever went wrong loading this vehicle's history.
               *
               * It sat inside the timeline panel until T2-303 and had to move,
               * because all three tabs are now drawn from the same one array
               * of records. A reader on Current state or Planned work after a
               * failed request saw a panel with nothing in it and no
               * explanation anywhere on screen — the PR #68 defect exactly,
               * one tab over, and worse there because a derived sheet with
               * nothing in it reads as a *finding* about the truck.
               *
               * Above the tablist rather than duplicated into each panel: one
               * live region announces once, where three would talk over each
               * other, and this one is visible whichever tab is open. Kept in
               * the layout always, empty or not — a live region that is
               * `display: none` when empty is not in the accessibility tree,
               * so its first message is the one nobody hears.
               */}
              <p
                class="garage__message"
                data-garage-records-message
                role="status"
                aria-live="polite"
              />

              <div
                class="garage__tabs"
                role="tablist"
                aria-label={strings.garageTabsLabel}
              >
                <button
                  class="garage__tab"
                  type="button"
                  role="tab"
                  id="garage-tab-timeline"
                  aria-controls="garage-panel-timeline"
                  aria-selected="true"
                  data-garage-tab="timeline"
                >
                  {strings.garageTabTimeline}
                </button>
                <button
                  class="garage__tab"
                  type="button"
                  role="tab"
                  id="garage-tab-current"
                  aria-controls="garage-panel-current"
                  aria-selected="false"
                  tabindex="-1"
                  data-garage-tab="current"
                >
                  {strings.garageTabCurrent}
                </button>
