                    <button class="garage__link" type="button" data-entry-edit>
                      {strings.garageRecordEdit}
                    </button>
                  </div>
                </div>
              </li>
            </template>

            {/*
             * A data chip carries a figure and, for anyone not reading the
             * layout, the word that says which figure it is. The label is real
             * text placed off-screen rather than an `aria-label`, so it is
             * translated, selectable and findable — and so a chip is never a
             * bare "1.2 h" with no context.
             */}
            <template data-garage-chip-template>
              <li class="garage__chip">
                <span class="garage__sr-only" data-chip-label />
                <span data-chip-value />
              </li>
            </template>

            <template data-garage-link-template>
              <li class="garage__minichip" data-link />
            </template>

            {/*
             * One line of the derived current-state sheet: what was serviced,
             * and when it was last done. The name reuses the same
             * `problem:`/`part:`/`procedure:` templates the timeline's chips
             * use, so one reference entry is named the same way wherever the
             * page mentions it.
             */}
            <template data-garage-service-template>
              <li class="garage__sheet-line">
                <span class="garage__sheet-line-name" data-service-name />
                <span class="garage__sheet-line-meta" data-service-meta />
              </li>
            </template>

            {/*
             * One totalled figure on the planned queue: its label, the figure,
             * and **its own** coverage sentence.
             *
             * The coverage belongs to the row and not to the panel (T2-303
             * review, F1). One sentence under a stack of rows describes
             * whichever row the reader happens to associate it with: a queue of
             * 7 with 2 time-only plans and 4 cost-only ones read as "2 h,
             * $400, from 4 of 7", which is true of neither. `PlannedEstimate`
             * carries a count per figure so this slot always has a truthful
             * number to put in.
             */}
            <template data-garage-estimate-template>
              <li class="garage__sheet-line garage__sheet-line--estimate">
                <span class="garage__sheet-line-name" data-estimate-label />
                <span class="garage__sheet-line-meta" data-estimate-value />
                <span
                  class="garage__sheet-line-coverage"
                  data-estimate-coverage
                />
              </li>
            </template>

            <template data-garage-receipt-template>
              <li class="garage__receipt">
                <span class="garage__receipt-text" data-receipt-label />
                <a
                  class="garage__link"
                  data-receipt-open
                  target="_blank"
                  rel="noopener"
                >
                  {strings.garageReceiptOpen}
                </a>
                <button
                  class="garage__link garage__link--danger"
                  type="button"
                  data-receipt-remove
                >
                  {strings.garageReceiptRemove}
                </button>
              </li>
            </template>

            {/*
             * One media attachment, with all three players in the template and
             * the two the row is not removed at paint time.
             *
             * A photo, a video and a voice note are three different elements
             * and there is no honest way to render one as another — an
             * `<audio>` for a video plays sound over a blank rectangle, which
             * is why `media_kind` is a closed set in the schema rather than
             * free text. `preload="none"` on both players is deliberate: a
             * record with four videos would otherwise open four signed-URL
             * range requests the moment the form is opened, for files the
             * reader may never play.
             */}
            <template data-garage-media-template>
              <li class="garage__media">
                <span class="garage__media-text" data-media-label />
                <img class="garage__media-image" data-media-image alt="" />
                <video
                  class="garage__media-player"
                  data-media-video
                  controls
                  preload="none"
                />
                <audio
                  class="garage__media-player"
                  data-media-audio
                  controls
                  preload="none"
                />
                <span class="garage__media-actions">
                  <a
                    class="garage__link"
                    data-media-open
                    target="_blank"
                    rel="noopener"
                  >
                    {strings.garageMediaOpen}
                  </a>
                  <button
                    class="garage__link garage__link--danger"
                    type="button"
                    data-media-remove
                  >
                    {strings.garageMediaRemove}
                  </button>
                </span>
              </li>
            </template>

            {/*
             * What a record may point at (GAR-02′), inlined once per page.
             * `set:html` on a `<script type="application/json">` is JSON, not
             * markup: the browser never executes it, and `JSON.stringify`
             * escapes every value that goes in. The same seam
             * `VehicleSelector.astro` uses for the taxonomy payload.
             */}
            <script
              type="application/json"
              data-garage-references
              is:inline
              set:html={referenceCatalogueJson}
            />
          </div>
        </Fragment>
      ) : (
        <p class="garage__notice">{strings.garageUnavailable}</p>
      )
    }
  </section>
</BaseLayout>

<script>
