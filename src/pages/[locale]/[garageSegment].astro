      ),
      recordPublic: query<HTMLInputElement>("[data-garage-record-public]"),
      recordCostPublic: query<HTMLInputElement>(
        "[data-garage-record-cost-public]"
      ),
      recordVisibilityMessage: query<HTMLElement>(
        "[data-garage-record-visibility-message]"
      ),
    };

    const payload = readSelectorPayload(document) as SelectorPayload | null;
    const options: VehicleOptions | null =
      payload === null ? null : createVehicleOptions(payload);

    /**
     * What a record may link to, read from the payload the server inlined.
     *
     * A missing or malformed payload degrades to "nothing to link", which is
     * also what an empty reference side looks like — so a page that cannot
     * read it renders the same honest state rather than throwing during boot.
     */
    const catalogue: ReferenceCatalogue = readCatalogue();

    function readCatalogue(): ReferenceCatalogue {
      const node = root.querySelector("[data-garage-references]");
      if (node === null) return EMPTY_CATALOGUE;
      try {
        const parsed: unknown = JSON.parse(node.textContent ?? "");
        if (typeof parsed !== "object" || parsed === null) {
          return EMPTY_CATALOGUE;
        }
        const candidate = parsed as ReferenceCatalogue;
        if (
          !Array.isArray(candidate.problem) ||
          !Array.isArray(candidate.part) ||
          !Array.isArray(candidate.procedure)
        ) {
          return EMPTY_CATALOGUE;
        }
        return candidate;
      } catch {
        return EMPTY_CATALOGUE;
      }
    }

    let vehicles: VehicleRow[] = [];
    let editing: VehicleRow | null = null;
    let opened: VehicleRow | null = null;
    let unit: OdometerUnit = readOdometerUnit(window);
    /*
     * The account's own profile, or `null` for "not known" (T2-402, SHR-02).
     *
     * `null` is deliberately not "has no handle": a profile that failed to load
     * and a profile with no handle chosen are different facts, and only one of
     * them means "go ahead and publish". The publishing switches read this, so
     * flattening the failure into "no handle" would tell an owner who already
     * has an address that they need to choose one — and flattening it the other
     * way would offer to publish a page that has nowhere to live.
     */
    let profile: ProfileRow | null = null;
    /** Pending, loaded, or failed — three states, because they need three sentences. */
    let profileStatus: "loading" | "loaded" | "failed" = "loading";
    /*
     * This vehicle's records, or `null` for "not known".
     *
     * `null` and `[]` are different answers and the type says so (PR #68,
     * generalized by T2-303). `[]` means the owner has recorded nothing;
     * `null` means the request has not landed or did not succeed. Three tabs
     * are now drawn from this one array — the timeline, the derived
     * current-state sheet and the derived planned queue — and the two derived
     * ones state *conclusions about the truck*. "No odometer reading",
     * "nothing serviced", "nothing planned" are all wrong answers when the
     * truth is "the records did not arrive", so the failure is carried in the
     * type rather than flattened into an empty array at the fetch site.
     */
    let records: RecordRow[] | null = null;
    /*
     * Why `records === null` is not enough on its own (T2-303 review, F2).
     *
     * `null` covers both "the request has not come back" and "the request
     * failed", and the two need different words. The failure copy is past
     * tense — "they could not be loaded" — so showing it during the ordinary
     * network beat asserts a failure that has not happened, which is the same
     * class of wrong answer as rendering `[]` for a failure. Pending is not
     * failed, exactly as `null` is not `[]`.
     */
    let recordsStatus: "loading" | "loaded" | "failed" = "loading";
    let editingRecord: RecordRow | null = null;
    let receipts: ReceiptRow[] = [];
    let media: RecordMediaRow[] = [];
    let currency = readCurrency(window, locale);
    /*
     * The unit the time field is currently written in.
     *
     * Held here rather than read off the `<select>` at each use, because the
     * two have to change in a defined order: the digits in the box mean
     * something different under each unit, so "what unit is the box in?" is a
     * question about the last *conversion*, not about the control's current
     * value. Reading the control instead is what made the first version
     * reinterpret `2` hours as two minutes (T2-302 review, F4).
     */
    let recordTimeUnit: TimeUnit = "h";

    /* --------------------------------------------------------------- view */

    function show(view: "list" | "detail" | "form" | "record"): void {
      els.listView.hidden = view !== "list";
      els.detailView.hidden = view !== "detail";
      els.form.hidden = view !== "form";
      if (els.recordForm) els.recordForm.hidden = view !== "record";
    }

    /**
     * Leave the boot state. `boot` is what the CSS reads to keep the sign-in
     * prompt down while the session resolves; after this the prompt is an
     * ordinary block governed by its own `hidden`.
     */
    function settle(gateVisible: boolean): void {
      root.dataset.garageState = gateVisible ? "signed-out" : "signed-in";
      els.gate.hidden = !gateVisible;
    }

    function say(node: HTMLElement | null, value: string): void {
      if (node) node.textContent = value;
    }

    /**
     * The last resort: a promise in this file rejected.
     *
     * Every request here already returns an outcome rather than throwing, so
     * a rejection means the *code* did not arrive — `getSupabaseClient()`
     * dynamically imports the client, and that import fails when a deploy
     * rotates the chunk hash under an open tab, when the network drops
     * mid-fetch, or when an extension or a CSP blocks it.
     *
     * Without this the page had a much worse failure than an error message:
     * the boot promise never settled, so `data-garage-state` stayed `boot`
     * forever and a returning signed-in owner sat on the opening line with no
     * garage, no prompt, and nothing to click, in both locales (T2-301 review
     * F1, reproduced with puppeteer).
     *
     * So it says what happened and leaves the sign-in prompt up: reloading is
     * the only thing that helps, and if the session did expire, signing in is
     * the action that fixes it. Never silent — a caught rejection that
     * displays nothing is the same stall wearing a `catch`.
     */
    function unreachable(node: HTMLElement | null = els.message): void {
      settle(true);
      say(node, text.stringUnreachable ?? "");
    }

    /* ------------------------------------------------------------ options */

    function option(value: string, label: string): HTMLOptionElement {
      const element = document.createElement("option");
      element.value = value;
      element.textContent = label;
      return element;
    }

    function unknownOption(): HTMLOptionElement {
      return option("", text.stringFacetUnknown ?? "");
    }

    /**
     * Rebuild market, year and engine from the chosen generation down.
     *
     * The narrowing itself is `createVehicleOptions` — the selector's module,
     * reading the selector's payload. Nothing here decides what may be
     * offered; a combination the taxonomy calls impossible is absent because
     * `enginesFor` left it out (FIT-01).
     */
    function refillIdentity(
      keep: {
        market?: string;
        year?: string;
        engine?: string;
      } = {}
    ): void {
      if (
        !options ||
        !els.generation ||
        !els.market ||
        !els.year ||
        !els.engine
      ) {
        return;
      }
      const gen = els.generation.value;

      const markets = options.marketsFor(gen);
      els.market.replaceChildren(
        unknownOption(),
        ...markets.map((entry) =>
          option(
            entry.id,
            `${payload?.labels.market[entry.id] ?? entry.id} — ${entry.name}`
          )
        )
      );
      els.market.value = markets.some((entry) => entry.id === keep.market)
        ? (keep.market ?? "")
        : "";

      const years = options.yearsFor(gen);
      els.year.replaceChildren(
        unknownOption(),
        ...years.map((value) => option(String(value), String(value)))
      );
      els.year.value = years.some((value) => String(value) === keep.year)
        ? (keep.year ?? "")
        : "";

      refillEngines(keep.engine);
    }

    function refillEngines(keep?: string): void {
      if (
        !options ||
        !els.market ||
        !els.year ||
        !els.engine ||
        !els.generation
      ) {
        return;
      }
      const gen = els.generation.value;
      const market = els.market.value;
      const year = Number.parseInt(els.year.value, 10);

      // An engine list needs a market and a year to narrow against. Until
      // both are answered the only honest option is "not sure yet" — the
      // alternative would be offering every engine in the corpus.
      const choices: readonly EngineChoice[] =
        market === "" || Number.isNaN(year)
          ? []
          : options.enginesFor(gen, market, year);

      const children: HTMLElement[] = [unknownOption()];
      const groups: [string, EngineChoice[]][] = [
        [
          text.stringEnginesRecorded ?? "",
          choices.filter((choice) => choice.recorded),
        ],
        [
          text.stringEnginesUnrecorded ?? "",
          choices.filter((choice) => !choice.recorded),
        ],
      ];
      for (const [label, members] of groups) {
        if (members.length === 0) continue;
        const group = document.createElement("optgroup");
        group.label = label;
        for (const choice of members) {
          group.append(
            option(
              choice.option.id,
              payload?.labels.engine[choice.option.id] ?? choice.option.id
            )
          );
        }
        children.push(group);
      }
      if (choices.length === 0 && market !== "" && !Number.isNaN(year)) {
        const none = option("", text.stringNoEngines ?? "");
        none.disabled = true;
        children.push(none);
      }

      els.engine.replaceChildren(...children);
      els.engine.value = choices.some((choice) => choice.option.id === keep)
        ? (keep ?? "")
        : "";
    }

    /* ------------------------------------------------------------- labels */

    /** `Gen 3 · US · 2002 · 6G74 SOHC`, or as much of it as is known. */
    function identityLabel(row: VehicleRow): string {
      const generation =
        payload?.labels.generation[row.generation_id] ?? row.generation_id;
      const selection = vehicleSelectionOf(row);
      if (selection === null || payload === null) return generation;
      return vehicleChipLabel({
        generationLabel: generation,
        market: selection.market,
        year: selection.year,
        engine:
          payload.engines.find((entry) => entry.id === selection.engine) ??
          null,
      });
    }

    /* --------------------------------------------------------------- draft */

    function currentDraft(): VehicleDraft {
      return {
        displayName: els.name?.value ?? "",
        gen: els.generation?.value ?? "",
        market: els.market?.value ?? "",
        year: els.year?.value ?? "",
        engine: els.engine?.value ?? "",
        odometer: els.odometer?.value ?? "",
        odometerUnit: unit,
      };
    }

    /** The first issue's message — one sentence a reader can act on. */
    function issueMessage(issues: readonly VehicleDraftIssue[]): string {
      const first = issues[0];
      if (!first) return "";
      if (first.field === "displayName") {
        return first.code === "required"
          ? (text.stringIssueNameRequired ?? "")
          : (text.stringIssueNameLong ?? "");
      }
      if (first.field === "gen") {
        return first.code === "required"
          ? (text.stringIssueGeneration ?? "")
          : (text.stringIssueIdentity ?? "");
      }
      if (first.field === "year") return text.stringIssueYear ?? "";
      if (first.field === "odometer") {
        return first.code === "too-large"
          ? (text.stringIssueOdometerLarge ?? "")
          : (text.stringIssueOdometer ?? "");
      }
      return text.stringIssueIdentity ?? "";
    }

    function openForm(row: VehicleRow | null): void {
      editing = row;
      say(els.formMessage, "");
      say(
        els.formHeading,
        (row === null ? text.stringFormNew : text.stringFormEdit) ?? ""
      );
      if (els.remove) els.remove.hidden = row === null;

      const draft = row === null ? EMPTY_DRAFT : draftFromVehicleRow(row, unit);
      if (els.name) els.name.value = draft.displayName;
      if (els.odometer) els.odometer.value = draft.odometer;
      if (els.odometerUnit) els.odometerUnit.value = unit;
      if (els.generation) {
        els.generation.value =
          draft.gen === ""
            ? (els.generation.options[0]?.value ?? "")
            : draft.gen;
      }
      refillIdentity({
        market: draft.market,
        year: draft.year,
        engine: draft.engine,
      });

      show("form");
      els.name?.focus();
    }

    /* --------------------------------------------------------------- paint */

    function paintList(): void {
      els.list.replaceChildren();
      els.empty.hidden = vehicles.length > 0;

      for (const row of sortVehicles(vehicles, locale)) {
        const item = els.rowTemplate.content.firstElementChild?.cloneNode(
          true
        ) as HTMLElement | null;
        if (!item) continue;
        const name = item.querySelector<HTMLElement>("[data-row-name]");
        const identity = item.querySelector<HTMLElement>("[data-row-identity]");
        const open = item.querySelector<HTMLButtonElement>("[data-row-open]");
        say(name, row.display_name);
        say(identity, identityLabel(row));
        // The button's own words came from the server; the truck's name is
        // the user's, so it goes on the accessible name rather than into a
        // sentence this script would have had to compose.
        open?.setAttribute(
          "aria-label",
          `${open.textContent} — ${row.display_name}`
        );
        open?.addEventListener("click", () => openDetail(row));
        els.list.append(item);
      }
    }

    function openDetail(row: VehicleRow): void {
      opened = row;
      say(els.detailName, row.display_name);
      /*
       * The vehicle's name is the heading of this panel, and it is the user's
       * word, so it cannot be server-rendered. Shipping an empty `<h2>` for
       * the script to fill is what a11y tooling calls "heading tag with no
       * content" (WCAG2AA H42.2) — correctly: an empty heading is a landmark
       * that announces nothing. So the element ships as a paragraph and
       * becomes a heading at the moment it has something to head.
       */
      els.detailName?.setAttribute("role", "heading");
      els.detailName?.setAttribute("aria-level", "2");
      say(els.detailIdentity, identityLabel(row));
      say(
        els.statOdometer,
        row.odometer_km === null
          ? (text.stringUnrecorded ?? "")
          : formatOdometer(row.odometer_km, unit, locale)
      );
      /*
       * Unknown until the records arrive, rather than the previous vehicle's
       * figures sitting under the new vehicle's name for a beat — and
       * `null` rather than `[]`, because for the beat before the request
       * lands the honest answer really is "not known yet". `[]` here would
       * flash "nothing has ever been done to this truck" on every open.
       */
      records = null;
      recordsStatus = "loading";
      paintRecords(new Map());
      say(els.browseNote, "");
      if (els.browse) {
        els.browse.disabled = vehicleSelectionOf(row) === null;
        if (els.browse.disabled) {
          say(els.browseNote, text.stringIdentityIncomplete ?? "");
        }
      }
      // SHR-02's two switches, from this row rather than from the last one
      // opened — a checkbox carried over from another truck is a claim about
      // this truck that nobody made.
      say(els.visibilityMessage, "");
      paintVisibility(row);
      show("detail");
      void paintPhotos(row).catch(() => unreachable(els.photoMessage));
      // Beside the rail, like every other way loading records can fail. The
      // app-level line stays for the boot path, which is about the whole page
      // rather than about this panel.
      void loadRecords(row).catch(() => {
        /*
         * The same staleness guard `loadRecords` makes, because this handler
         * writes the same state and had none at all (T2-303 F8).
         *
         * A rejection for the vehicle the reader has already navigated away
         * from would otherwise wipe the vehicle they *are* looking at: open
         * A, switch to B, B loads and paints, then A's import or fetch
         * rejects — and B's good records become `null` and the page says it
         * failed, permanently, because B's own request is long finished.
         */
        if (opened?.id !== row.id) return;
        // A rejection is a failure too, and the panels must leave "loading"
        // for it — otherwise the derived tabs sit on "working this out from
        // your records…" forever with nothing ever arriving (T2-303 F2's
        // mirror image: pending must not outlive the request either).
        records = null;
        recordsStatus = "failed";
        paintRecords(new Map());
        unreachable(els.recordsMessage);
      });
    }

    async function paintPhotos(row: VehicleRow): Promise<void> {
      if (!els.gallery) return;
      const paths = vehiclePhotoPaths(row);
      els.gallery.replaceChildren();
      if (els.photosEmpty) els.photosEmpty.hidden = paths.length > 0;
      if (paths.length === 0) return;

      const urls = await signPhotoUrls(paths);
      // A vehicle opened, then closed, then another opened while the signing
      // request was in flight would otherwise paint the wrong gallery.
      if (opened?.id !== row.id) return;

      for (const path of paths) {
        const url = urls.get(path);
        if (url === undefined) continue;
        const item = els.photoTemplate.content.firstElementChild?.cloneNode(
          true
        ) as HTMLElement | null;
        if (!item) continue;
        const image =
          item.querySelector<HTMLImageElement>("[data-photo-image]");
        const drop = item.querySelector<HTMLButtonElement>(
          "[data-photo-remove]"
        );
        if (image) {
          image.src = url;
          image.loading = "lazy";
          image.alt = (text.stringPhotoAlt ?? "").replace(
            "{name}",
            row.display_name
          );
        }
        drop?.addEventListener("click", () => {
          void dropPhoto(row, path).catch(() => unreachable(els.photoMessage));
        });
        els.gallery.append(item);
      }
    }

    /* ------------------------------------------------------------ records */

    /** The reader's word for a kind, from the `<select>` the server built. */
    function kindLabel(kind: string): string {
      const option = els.recordKind?.querySelector<HTMLOptionElement>(
        `option[value="${kind}"]`
      );
      return option?.textContent ?? kind;
    }

    /** One data chip: an off-screen label, then the figure. */
    function chip(label: string, value: string): HTMLElement | null {
      const item = els.chipTemplate?.content.firstElementChild?.cloneNode(
        true
      ) as HTMLElement | null;
      if (!item) return null;
      say(item.querySelector<HTMLElement>("[data-chip-label]"), label);
      say(item.querySelector<HTMLElement>("[data-chip-value]"), value);
      return item;
    }

    /**
     * Draw a list of records onto one of the two rails.
     *
     * Every string here is the server's: the meta line is `Intl` formatting
     * stored figures, the badge and the chip labels come from `data-string-*`,
     * and the title and body are the user's own words, set as `textContent`
     * and never composed into a sentence this script wrote.
     */
    function paintEntries(
      target: HTMLOListElement | null,
      empty: HTMLElement | null,
      rows: readonly RecordRow[] | null,
      countsByRecord: ReadonlyMap<string, number> | null
    ): void {
      if (!target) return;
      target.replaceChildren();
      /*
       * `rows === null` is "not known", and the one thing it must not do is
       * reveal the empty note: "nothing has been recorded on this vehicle" is
       * a claim about the truck, and a failed request has not earned it. The
       * live region above the tablist is what says what actually happened.
       */
      if (empty) empty.hidden = rows === null || rows.length > 0;
      if (rows === null) return;

      for (const row of rows) {
        const item = els.entryTemplate?.content.firstElementChild?.cloneNode(
          true
        ) as HTMLElement | null;
        if (!item) continue;

        const planned = isPlanned(row);
        item.classList.toggle("garage__entry--planned", planned);

        const meta = [formatRecordDate(row.occurred_on, locale)];
        if (row.odometer_km !== null) {
          meta.push(formatOdometer(row.odometer_km, unit, locale));
        }
        say(
          item.querySelector<HTMLElement>("[data-entry-meta]"),
          meta.join(" · ")
        );
        say(
          item.querySelector<HTMLElement>("[data-entry-title]"),
          recordHeadline(row, kindLabel(row.kind))
        );
        say(
          item.querySelector<HTMLElement>("[data-entry-badge]"),
          (planned ? text.stringStatusPlanned : text.stringStatusDone) ?? ""
        );
        say(
          item.querySelector<HTMLElement>("[data-entry-body]"),
          row.body ?? ""
        );

        const chips =
          item.querySelector<HTMLUListElement>("[data-entry-chips]");
        if (chips) {
          const built: (HTMLElement | null)[] = [];
          if (row.time_minutes !== null) {
            built.push(
              chip(
                text.stringChipTime ?? "",
                formatDuration(row.time_minutes, locale)
              )
            );
          }
          if (row.cost_amount !== null && row.cost_currency !== null) {
            built.push(
              chip(
                text.stringChipCost ?? "",
                formatCost(row.cost_amount, row.cost_currency, locale)
              )
            );
          }
          if (row.odometer_km !== null) {
            built.push(
              chip(
                text.stringChipOdometer ?? "",
                formatOdometer(row.odometer_km, unit, locale)
              )
            );
          }
          // `null` is "nobody knows", not "none": no chip either way, but the
          // notice above the rail is what tells the reader which one this is.
          const attached = countsByRecord?.get(row.id) ?? 0;
          if (attached > 0) {
            built.push(
              chip(
                text.stringChipReceipts ?? "",
                new Intl.NumberFormat(locale).format(attached)
              )
            );
          }
          chips.replaceChildren(
            ...built.filter((node): node is HTMLElement => node !== null)
          );
          chips.hidden = chips.childElementCount === 0;
        }

        const links =
          item.querySelector<HTMLUListElement>("[data-entry-links]");
        if (links) {
          const templates: Record<string, string | undefined> = {
            problem: text.stringRefProblem,
            part: text.stringRefPart,
            procedure: text.stringRefProcedure,
          };
          for (const reference of resolveReferences(row, catalogue)) {
            const node = els.linkTemplate?.content.firstElementChild?.cloneNode(
              true
            ) as HTMLElement | null;
            if (!node) continue;
            // An id the site can no longer resolve keeps its own text: this is
            // the owner's record, and tidying a dangling link away would be
            // deleting part of it.
            const name = reference.title ?? reference.id;
            say(
              node,
              (templates[reference.kind] ?? "{name}").replace("{name}", name)
            );
            if (reference.title === null) {
              node.classList.add("garage__minichip--unresolved");
              node.title = text.stringRefUnresolved ?? "";
            }
            links.append(node);
          }
          links.hidden = links.childElementCount === 0;
        }

        const edit = item.querySelector<HTMLButtonElement>("[data-entry-edit]");
        // The record's own line goes on the accessible name rather than into a
        // sentence this script would have had to compose, so a rail of "Edit"
        // buttons is still distinguishable.
        edit?.setAttribute(
          "aria-label",
          `${edit.textContent} — ${recordHeadline(row, kindLabel(row.kind))}`
        );
        edit?.addEventListener("click", () => {
          void openRecordForm(row).catch(() => unreachable(els.recordMessage));
        });

        target.append(item);
      }
    }

    /** A whole number in the reader's locale. */
    function count(value: number): string {
      return new Intl.NumberFormat(locale).format(value);
    }

    /** The reader's name for one reference entry, or the id when unresolved. */
    function referenceName(line: ServiceLine): string {
      const templates: Record<string, string | undefined> = {
        problem: text.stringRefProblem,
        part: text.stringRefPart,
        procedure: text.stringRefProcedure,
      };
      return (templates[line.kind] ?? "{name}").replace(
        "{name}",
        line.title ?? line.id
      );
    }

    /**
     * The current-state sheet (GAR-03′), from `currentState`.
     *
     * `sheet === null` is the records request having failed; the three states
     * are mutually exclusive here and the markup keeps them in three separate
     * elements so they cannot half-overlap.
     */
    /**
     * Every slot on the current-state sheet, emptied.
     *
     * Called whenever there is no sheet to draw, so no figure outlives the
     * vehicle it was computed for. The odometer is the one that matters —
     * "251 930 km" left under another truck's name is not a stale render, it
     * is a false statement — but the service lines and the open-item counts
     * are the same kind of claim and go the same way.
     */
    function clearCurrentState(): void {
      say(els.currentOdometer, "");
      say(els.currentOdometerOn, "");
      if (els.currentOdometerWarning) els.currentOdometerWarning.hidden = true;
      els.currentServices?.replaceChildren();
      if (els.currentServicesEmpty) els.currentServicesEmpty.hidden = true;
      say(els.currentOpenOverdue, "");
      say(els.currentOpenUpcoming, "");
    }

    function paintCurrentState(sheet: CurrentState | null): void {
      const empty = sheet !== null && sheet.recordsConsidered === 0;
      if (els.currentLoading) {
        els.currentLoading.hidden = recordsStatus !== "loading";
      }
      if (els.currentUnavailable) {
        els.currentUnavailable.hidden = recordsStatus !== "failed";
      }
      if (els.currentEmpty) els.currentEmpty.hidden = !empty;
      if (els.currentSheet) els.currentSheet.hidden = sheet === null || empty;
      if (sheet === null || empty) {
        /*
         * Emptied, not merely hidden (T2-303 review, F9).
         *
         * The `hidden` attribute above is now backed by a CSS guard, but a
         * stale figure that is only *invisible* is one style regression away
         * from being a wrong answer again — and this panel's wrong answer is
         * the previous vehicle's odometer asserted as a fact about this one.
         * So the slots are cleared as well: the two mechanisms fail
         * independently, and nothing here survives the vehicle it described.
         */
        clearCurrentState();
        return;
      }

      const reading = sheet.odometer;
      say(
        els.currentOdometer,
        reading === null
          ? (text.stringCurrentOdometerUnknown ?? "")
          : formatOdometer(reading.km, unit, locale)
      );
      // The date only exists when the reading does; an empty line rather than
      // a sentence with a hole in it where `{date}` was.
      say(
        els.currentOdometerOn,
        reading === null
          ? ""
          : (text.stringCurrentOdometerOn ?? "").replace(
              "{date}",
              formatRecordDate(reading.occurredOn, locale)
            )
      );
      if (els.currentOdometerWarning) {
        els.currentOdometerWarning.hidden = !reading?.contradicted;
      }

      if (els.currentServices) {
        els.currentServices.replaceChildren();
        for (const line of sheet.services) {
          const item =
            els.serviceTemplate?.content.firstElementChild?.cloneNode(
              true
            ) as HTMLElement | null;
          if (!item) continue;
          const name = item.querySelector<HTMLElement>("[data-service-name]");
          say(name, referenceName(line));
          if (line.title === null && name !== null) {
            // The same treatment the timeline's chips give a retired entry:
            // kept, marked, never dropped.
            name.classList.add("garage__sheet-line-name--unresolved");
            name.title = text.stringRefUnresolved ?? "";
          }
          const since =
            line.sinceKm === null
              ? (text.stringServiceSinceUnknown ?? "")
              : (text.stringServiceSince ?? "").replace(
                  "{distance}",
                  formatOdometer(line.sinceKm, unit, locale)
                );
          say(
            item.querySelector<HTMLElement>("[data-service-meta]"),
            `${(text.stringServiceLast ?? "").replace(
              "{date}",
              formatRecordDate(line.lastDoneOn, locale)
            )} · ${since}`
          );
          els.currentServices.append(item);
        }
      }
      if (els.currentServicesEmpty) {
        els.currentServicesEmpty.hidden = sheet.services.length > 0;
      }

      say(
        els.currentOpenOverdue,
        (text.stringOpenOverdue ?? "").replace(
          "{count}",
          count(sheet.open.overdue)
        )
      );
      say(
        els.currentOpenUpcoming,
        (text.stringOpenUpcoming ?? "").replace(
          "{count}",
          count(sheet.open.upcoming)
        )
      );
    }

    /**
     * The planned-work queue (GAR-03′ / 001 GAR-03), from `plannedQueue`.
     *
     * The two rails are the queue's own two groups in the queue's own order,
     * so reading down the panel reads the queue in priority order.
     */
    function paintPlannedQueue(
      queue: readonly PlannedItem[] | null,
      countsByRecord: ReadonlyMap<string, number> | null
    ): void {
      const empty = queue !== null && queue.length === 0;
      if (els.plannedLoading) {
        els.plannedLoading.hidden = recordsStatus !== "loading";
      }
      if (els.plannedUnavailable) {
        els.plannedUnavailable.hidden = recordsStatus !== "failed";
      }
      if (els.plannedEmpty) els.plannedEmpty.hidden = !empty;
      if (els.plannedQueueView) {
        els.plannedQueueView.hidden = queue === null || empty;
      }
      if (queue === null || empty) {
        /*
         * Both rails cleared, and the group blocks and estimate rows with
         * them (T2-303 review, F9). The panel's own note — loading, unknown
         * or empty — is what speaks; nothing here may keep the last vehicle's
         * plans or its totals, and the two group headings must not stand over
         * emptied rails.
         */
        const cleared = queue === null ? null : [];
        paintEntries(els.plannedOverdue, null, cleared, countsByRecord);
        paintEntries(els.plannedUpcoming, null, cleared, countsByRecord);
        if (els.plannedOverdueBlock) els.plannedOverdueBlock.hidden = true;
        if (els.plannedUpcomingBlock) els.plannedUpcomingBlock.hidden = true;
        els.plannedEstimate?.replaceChildren();
        if (els.plannedEstimateNone) els.plannedEstimateNone.hidden = true;
        if (els.plannedEstimateCurrencyNote) {
          els.plannedEstimateCurrencyNote.hidden = true;
        }
        return;
      }

      const overdue = plannedGroup(queue, "overdue");
      const upcoming = plannedGroup(queue, "upcoming");
      // A group with nothing in it is hidden rather than shown with an empty
      // rail: an "Past their date" heading over nothing invites the reader to
      // look for what is not there.
      if (els.plannedOverdueBlock) {
        els.plannedOverdueBlock.hidden = overdue.length === 0;
      }
      if (els.plannedUpcomingBlock) {
        els.plannedUpcomingBlock.hidden = upcoming.length === 0;
      }
      paintEntries(els.plannedOverdue, null, overdue, countsByRecord);
      paintEntries(els.plannedUpcoming, null, upcoming, countsByRecord);

      /*
       * Each total is built with **its own** coverage and never a shared one
       * (T2-303 review, F1). One sentence under a stack of rows describes
       * whichever row the reader pairs it with: 7 plans, 2 carrying only a
       * time and 4 only a cost, rendered as "2 h; $400; from 4 of 7" — true
       * of neither figure, and precisely the failure the module documents
       * preventing. `PlannedEstimate` therefore has no "items with any
       * estimate" field to reach for; the duration carries `itemsWithTime`
       * and each currency carries its own `items`.
       */
      const estimate = plannedEstimate(queue);
      const rows: HTMLElement[] = [];
      if (estimate.minutes !== null) {
        const row = estimateRow(
          text.stringEstimateTime ?? "",
          formatDuration(estimate.minutes, locale),
          estimate.itemsWithTime,
          estimate.totalItems
        );
        if (row) rows.push(row);
      }
      /*
       * One line per currency, never one line of everything added together.
       * `plannedEstimate` returns a map precisely so this loop is the only
       * shape the data can be rendered in — there is no single total in the
       * result to accidentally print (`src/lib/garage/derived.ts`).
       */
      for (const [code, total] of estimate.byCurrency) {
        const row = estimateRow(
          text.stringEstimateCost ?? "",
          formatCost(total.amount, code, locale),
          total.items,
          estimate.totalItems
        );
        if (row) rows.push(row);
      }
      els.plannedEstimate?.replaceChildren(...rows);

      if (els.plannedEstimateNone) {
        els.plannedEstimateNone.hidden = rows.length > 0;
      }
      if (els.plannedEstimateCurrencyNote) {
        els.plannedEstimateCurrencyNote.hidden = estimate.byCurrency.size < 2;
      }
    }

    /**
     * One totalled figure on the planned queue, with the coverage that makes
     * it honest.
     *
     * A total is a lie without its coverage: six hours over a queue of seven
     * where two items carry an estimate is six hours of the two, not of the
     * queue. `counted` is always the count for *this* figure — the caller has
     * no shared number available to pass by mistake.
     */
    function estimateRow(
      label: string,
      value: string,
      counted: number,
      total: number
    ): HTMLElement | null {
      const item = els.estimateTemplate?.content.firstElementChild?.cloneNode(
        true
      ) as HTMLElement | null;
      if (!item) return null;
      say(item.querySelector<HTMLElement>("[data-estimate-label]"), label);
      say(item.querySelector<HTMLElement>("[data-estimate-value]"), value);
      say(
        item.querySelector<HTMLElement>("[data-estimate-coverage]"),
        (text.stringEstimateCoverage ?? "")
          .replace("{counted}", count(counted))
          .replace("{total}", count(total))
      );
      return item;
    }

    /**
     * All three tabs and the two stats, from one array of records.
     *
     * `countsByRecord === null` means the receipts request failed, and the
     * cards say so above the rail rather than drawing every record as though
     * it had no receipts (PR #68). Painting the notice here and not at the
     * call site is deliberate: every path that renders the tabs goes through
     * this function, so none of them can render the ambiguous state silently.
     *
     * `records === null` is the larger version of the same idea and is why
     * every function called below takes a nullable list: the timeline, the
     * derived sheet and the derived queue each have their own way of saying
     * "not known", and none of them may say "nothing" instead.
     */
    function paintRecords(
      countsByRecord: ReadonlyMap<string, number> | null
    ): void {
      say(
        els.recordsMessage,
        countsByRecord === null
          ? (text.stringReceiptCountsUnavailable ?? "")
          : ""
      );
      paintEntries(
        els.timeline,
        els.timelineEmpty,
        records === null ? null : timelineOrder(records),
        countsByRecord
      );
      paintCurrentState(currentState(records, catalogue, todayLocal()));
      paintPlannedQueue(plannedQueue(records, todayLocal()), countsByRecord);

      // The stat row is the vehicle's own summary and has the same two
      // answers: a figure when the records are known, the "not recorded"
      // dash when they are not — never a confident zero.
      const counts = records === null ? null : recordCounts(records);
      say(
        els.statEntries,
        counts === null ? (text.stringUnrecorded ?? "") : count(counts.entries)
      );
      say(
        els.statPlanned,
        counts === null ? (text.stringUnrecorded ?? "") : count(counts.planned)
      );
    }

    /**
     * Load one vehicle's records and the receipt counts that go on their
     * cards.
     *
     * Two requests, and they fail differently on purpose (PR #68).
     *
     * **The records themselves** are the page. If that request fails there is
     * nothing honest to draw, so nothing is drawn and the rail says why: an
     * empty rail alone would read as "you have never recorded anything",
     * which is a wrong answer rather than a missing one.
     *
     * **The receipt counts** are one chip on each card. If only that request
     * fails, throwing away a work log that arrived intact would cost the
     * reader the whole page to hide a decoration — so the records still
     * paint, and the counts come through as `null`, which
     * {@link paintRecords} renders as a notice above the rail and no chips at
     * all. That keeps the failure visible without letting a missing chip
     * assert "no receipts". Each record's own receipts are still reachable by
     * opening it, where `paintReceipts` makes its own request and reports its
     * own failure.
     *
     * Both messages land beside the rail rather than in the app-level line at
     * the foot of the page, because both are about what is (or is not) drawn
     * there.
     */
    async function loadRecords(vehicle: VehicleRow): Promise<void> {
      const result = await listRecords(vehicle.id);
      /*
       * The staleness guard, before the outcome is read at all (T2-303 F8).
       *
       * It used to sit *after* the `!result.ok` branch, which guarded the
       * success path and left the failure path open — and a failure is the
       * more destructive thing to apply to the wrong vehicle. Open A, switch
       * to B, let B load and paint correctly, then let A's request fail: the
       * unguarded branch below would replace B's good records with `null` and
       * mark the page failed, and nothing would correct it, because B's own
       * request had already finished. A wrong answer with no path back to the
       * right one.
       *
       * One guard covering both outcomes rather than one per branch: the
       * question "is this still the vehicle on screen?" has nothing to do
       * with whether the request succeeded, and asking it once is one fewer
       * place for the next branch to forget.
       */
      if (opened?.id !== vehicle.id) return;
      if (!result.ok) {
        // `null`, not `[]`. This is the whole point of the nullable type: the
        // three tabs are drawn from this one value, and two of them state
        // conclusions about the truck. `[]` here published three of them —
        // no history, no mileage, nothing planned — off a failed request.
        records = null;
        recordsStatus = "failed";
        paintRecords(new Map());
        say(els.recordsMessage, text.stringError ?? "");
        return;
      }
      const loaded = result.value;
      records = loaded;
      recordsStatus = "loaded";

      const attached = await listReceipts(loaded.map((row) => row.id));
      if (opened?.id !== vehicle.id) return;
      paintRecords(receiptCountsByRecord(attached.ok ? attached.value : null));
    }

    function currentRecordDraft(): RecordDraft {
      const chosen = (select: HTMLSelectElement | null): string[] =>
        select === null
          ? []
          : [...select.selectedOptions].map((option) => option.value);
      return {
        occurredOn: els.recordDate?.value ?? "",
        kind: els.recordKind?.value ?? "",
        title: els.recordTitle?.value ?? "",
        body: els.recordBody?.value ?? "",
        cost: els.recordCost?.value ?? "",
        currency: els.recordCurrency?.value ?? currency,
        time: els.recordTime?.value ?? "",
        timeUnit: recordTimeUnit,
        odometer: els.recordOdometer?.value ?? "",
        odometerUnit: unit,
        problemIds: chosen(els.recordProblems),
        partIds: chosen(els.recordParts),
        procedureIds: chosen(els.recordProcedures),
      };
    }

    /** The first issue's message — one sentence a reader can act on. */
    function recordIssueMessage(issues: readonly RecordDraftIssue[]): string {
      const first = issues[0];
      if (!first) return "";
      if (first.field === "occurredOn") {
        return first.code === "out-of-range"
          ? (text.stringRecordIssueDateRange ?? "")
          : (text.stringRecordIssueDate ?? "");
      }
      if (first.field === "kind") return text.stringRecordIssueKind ?? "";
      if (first.field === "title") {
        return first.code === "required"
          ? (text.stringRecordIssueTitle ?? "")
          : (text.stringRecordIssueTitleLong ?? "");
      }
      if (first.field === "body") {
        return text.stringRecordIssueNotesLong ?? "";
      }
      if (first.field === "cost" || first.field === "currency") {
        if (first.field === "cost" && first.code === "ambiguous-separator") {
          return text.stringRecordIssueCostSeparator ?? "";
        }
        if (first.field === "cost" && first.code === "too-large") {
          return text.stringRecordIssueCostLarge ?? "";
        }
        return text.stringRecordIssueCost ?? "";
      }
      if (first.field === "time") {
        return first.code === "too-large"
          ? (text.stringRecordIssueTimeLarge ?? "")
          : (text.stringRecordIssueTime ?? "");
      }
      if (first.field === "odometer") {
        return first.code === "too-large"
          ? (text.stringIssueOdometerLarge ?? "")
          : (text.stringIssueOdometer ?? "");
      }
      return text.stringRecordIssueReferences ?? "";
    }

    function applyRecordDraft(draft: RecordDraft): void {
      if (els.recordDate) els.recordDate.value = draft.occurredOn;
      if (els.recordKind) els.recordKind.value = draft.kind;
      if (els.recordTitle) els.recordTitle.value = draft.title;
      if (els.recordBody) els.recordBody.value = draft.body;
      if (els.recordCost) els.recordCost.value = draft.cost;
      if (els.recordCurrency) {
        els.recordCurrency.value =
          draft.currency === "" ? currency : draft.currency;
      }
      if (els.recordTime) els.recordTime.value = draft.time;
      // The control and the variable move together, always: `recordTimeUnit`
      // is what every read of the field is interpreted against, so a `<select>`
      // set without it would reinterpret the digits already in the box.
      recordTimeUnit = draft.timeUnit;
      if (els.recordTimeUnit) els.recordTimeUnit.value = draft.timeUnit;
      if (els.recordOdometer) els.recordOdometer.value = draft.odometer;
      const restore = (
        select: HTMLSelectElement | null,
        ids: readonly string[]
      ): void => {
        if (!select) return;
        for (const option of select.options) {
          option.selected = ids.includes(option.value);
        }
      };
      restore(els.recordProblems, draft.problemIds);
      restore(els.recordParts, draft.partIds);
      restore(els.recordProcedures, draft.procedureIds);
    }

    /**
     * Open the record form on a row, or on a blank draft.
     *
     * Async because an existing record's receipts are fetched and signed here:
     * the whole of a receipt's private surface — the row, the URL, the remove
     * button — exists only while its record is open in front of its owner.
     */
    async function openRecordForm(row: RecordRow | null): Promise<void> {
      editingRecord = row;
      receipts = [];
      media = [];
      say(els.recordMessage, "");
      say(els.receiptMessage, "");
      say(els.mediaMessage, "");
      say(
        els.recordHeading,
        (row === null ? text.stringRecordFormNew : text.stringRecordFormEdit) ??
          ""
      );
      if (els.recordDelete) els.recordDelete.hidden = row === null;
      if (els.receiptsNeedRecord) els.receiptsNeedRecord.hidden = row !== null;
      if (els.receiptForm) els.receiptForm.hidden = row === null;
      if (els.receiptsEmpty) els.receiptsEmpty.hidden = true;
      els.receiptList?.replaceChildren();
      clearReceiptDraft();
      if (els.mediaNeedRecord) els.mediaNeedRecord.hidden = row !== null;
      if (els.mediaForm) els.mediaForm.hidden = row === null;
      if (els.mediaEmpty) els.mediaEmpty.hidden = true;
      els.mediaList?.replaceChildren();
      if (els.mediaFile) els.mediaFile.value = "";
      // SHR-03's two switches, from this record. `null` is a record that does
      // not exist yet, and an unsaved record has nothing to publish.
      paintRecordVisibility(row);

      applyRecordDraft(
        row === null
          ? emptyRecordDraft({
              today: todayLocal(),
              currency,
              odometerUnit: unit,
              timeUnit: recordTimeUnit,
            })
          : recordDraftFromRow(row, {
              odometerUnit: unit,
              // The unit the reader last chose, carried across records: a
              // reader who thinks in minutes keeps thinking in minutes.
              timeUnit: recordTimeUnit,
            })
      );

      show("record");
      els.recordTitle?.focus();

      if (row !== null) {
        await paintReceipts(row);
        await paintMedia(row);
      }
    }

    /**
     * Today, as the `date` input and the `date` column both spell it.
     *
     * The reader's own local day rather than UTC's: a record written at nine
     * in the evening in Costa Rica is dated that evening, not tomorrow.
     * `toISOString` would do the opposite, which is why the parts are read one
     * at a time.
     */
    function todayLocal(): string {
      const now = new Date();
      const month = String(now.getMonth() + 1).padStart(2, "0");
      const day = String(now.getDate()).padStart(2, "0");
      return `${now.getFullYear()}-${month}-${day}`;
    }

    /* ----------------------------------------------------------- receipts */

    function currentReceiptDraft(): ReceiptDraft {
      return {
        vendor: els.receiptVendor?.value ?? "",
        issuedOn: els.receiptDate?.value ?? "",
        amount: els.receiptAmount?.value ?? "",
        currency: els.receiptCurrency?.value ?? currency,
      };
    }

    function clearReceiptDraft(): void {
      if (els.receiptFile) els.receiptFile.value = "";
      if (els.receiptVendor)
        els.receiptVendor.value = EMPTY_RECEIPT_DRAFT.vendor;
      if (els.receiptDate) els.receiptDate.value = EMPTY_RECEIPT_DRAFT.issuedOn;
      if (els.receiptAmount)
        els.receiptAmount.value = EMPTY_RECEIPT_DRAFT.amount;
      if (els.receiptCurrency) els.receiptCurrency.value = currency;
    }

    /** `Repuestos La Uruca · 12 Jul 2026 · ₡38 500`, or as much as is known. */
    function receiptLabel(receipt: ReceiptRow): string {
      const parts: string[] = [];
      if (receipt.vendor !== null && receipt.vendor.trim() !== "") {
        parts.push(receipt.vendor);
      }
      if (receipt.issued_on !== null) {
        parts.push(formatRecordDate(receipt.issued_on, locale));
      }
      if (receipt.amount !== null && receipt.currency !== null) {
        parts.push(formatCost(receipt.amount, receipt.currency, locale));
      }
      return parts.length === 0
        ? (text.stringReceiptUntitled ?? "")
        : parts.join(" · ");
    }

    async function paintReceipts(row: RecordRow): Promise<void> {
      if (!els.receiptList) return;
      const listed = await listReceipts([row.id]);
      // The form moved on while the request was in flight.
      if (editingRecord?.id !== row.id) return;
      if (!listed.ok) {
        say(els.receiptMessage, text.stringError ?? "");
        return;
      }
      receipts = sortReceipts(listed.value);
      els.receiptList.replaceChildren();
      if (els.receiptsEmpty) els.receiptsEmpty.hidden = receipts.length > 0;
      if (receipts.length === 0) return;

      const urls = await signReceiptUrls(
        receipts.map((receipt) => receipt.storage_path)
      );
      if (editingRecord?.id !== row.id) return;

      for (const receipt of receipts) {
        const item = els.receiptTemplate?.content.firstElementChild?.cloneNode(
          true
        ) as HTMLElement | null;
        if (!item) continue;
        const label = receiptLabel(receipt);
        say(item.querySelector<HTMLElement>("[data-receipt-label]"), label);

        const open = item.querySelector<HTMLAnchorElement>(
          "[data-receipt-open]"
        );
        const url = urls.get(receipt.storage_path);
        if (open) {
          if (url === undefined) {
            // Nothing to link to: a signature that could not be issued is not
            // a link that should sit there returning nothing when clicked.
            open.remove();
          } else {
            open.href = url;
            open.setAttribute("aria-label", `${open.textContent} — ${label}`);
          }
        }

        const drop = item.querySelector<HTMLButtonElement>(
          "[data-receipt-remove]"
        );
        drop?.setAttribute("aria-label", `${drop.textContent} — ${label}`);
        drop?.addEventListener("click", () => {
          if (!window.confirm(text.stringReceiptRemoveConfirm ?? "")) return;
          void dropReceipt(row, receipt).catch(() =>
            unreachable(els.receiptMessage)
          );
        });

        els.receiptList.append(item);
      }
    }

    async function dropReceipt(
      row: RecordRow,
      receipt: ReceiptRow
    ): Promise<void> {
      say(els.receiptMessage, "");
      const result = await removeReceipt(receipt);
      if (!result.ok) {
        say(els.receiptMessage, text.stringError ?? "");
        return;
      }
      await paintReceipts(row);
      if (opened !== null) await loadRecords(opened);
    }

    async function attachReceipt(row: RecordRow, file: File): Promise<void> {
      const draft = currentReceiptDraft();
      const issues = validateReceiptDraft(draft);
      if (issues.length > 0) {
        const first = issues[0];
        say(
          els.receiptMessage,
          (first?.field === "vendor"
            ? text.stringReceiptVendorLong
            : first?.field === "issuedOn"
              ? text.stringReceiptIssueDate
              : first?.code === "ambiguous-separator"
                ? text.stringRecordIssueCostSeparator
                : text.stringRecordIssueCost) ?? ""
        );
        return;
      }

      say(els.receiptMessage, text.stringReceiptUploading ?? "");
      const result = await uploadReceipt(row.id, file, (path) =>
        receiptWriteFromDraft(row.id, path, draft)
      );
      if (!result.ok) {
        say(
          els.receiptMessage,
          (result.reason === "rejected"
            ? text.stringReceiptType
            : text.stringError) ?? ""
        );
        return;
      }
      say(els.receiptMessage, "");
      clearReceiptDraft();
      await paintReceipts(row);
      if (opened !== null) await loadRecords(opened);
    }

    /* --------------------------------------------- media attachments (GAR-06′) */

    /**
     * `Voice note 2` — the kind, and its number within that kind.
     *
     * An attachment has no vendor, date or amount to be named by; GAR-06′ says
     * so, and that is the requirement rather than an omission. So the label is
     * the honest minimum, and it carries the index because "Remove" beside
     * three identical "Photo" rows is a button nobody using a screen reader
     * can aim at the one they mean.
     */
    function mediaLabel(kind: MediaKind, index: number): string {
      const template =
        (kind === "photo"
          ? text.stringMediaLabelPhoto
          : kind === "video"
            ? text.stringMediaLabelVideo
            : text.stringMediaLabelAudio) ?? kind;
      return template.replace("{index}", String(index));
    }

    /**
     * Paint one record's attachments.
     *
     * The same two-request shape as `paintReceipts` — rows, then signatures —
     * and the same two staleness checks, because both awaits can outlive the
     * form they were opened for. Each row renders as exactly one of three
     * elements and the other two are removed: an `<audio>` showing a video is a
     * blank rectangle that makes noise, which is the failure `media_kind`
     * exists as a closed set to prevent.
     */
    async function paintMedia(row: RecordRow): Promise<void> {
      if (!els.mediaList) return;
      const listed = await listRecordMedia([row.id]);
      if (editingRecord?.id !== row.id) return;
      if (!listed.ok) {
        say(els.mediaMessage, text.stringError ?? "");
        return;
      }
      media = sortRecordMedia(listed.value);
      els.mediaList.replaceChildren();
      if (els.mediaEmpty) els.mediaEmpty.hidden = media.length > 0;
      if (media.length === 0) return;

      const urls = await signRecordMediaUrls(
        media.map((entry) => entry.storage_path)
      );
      if (editingRecord?.id !== row.id) return;

      const seen = new Map<string, number>();
      for (const entry of media) {
        const item = els.mediaTemplate?.content.firstElementChild?.cloneNode(
          true
        ) as HTMLElement | null;
        if (!item) continue;

        const index = (seen.get(entry.media_kind) ?? 0) + 1;
        seen.set(entry.media_kind, index);
        const label = mediaLabel(entry.media_kind, index);
        say(item.querySelector<HTMLElement>("[data-media-label]"), label);

        const url = urls.get(entry.storage_path);
        const image =
          item.querySelector<HTMLImageElement>("[data-media-image]");
        const video =
          item.querySelector<HTMLVideoElement>("[data-media-video]");
        const audio =
          item.querySelector<HTMLAudioElement>("[data-media-audio]");
        const player =
          entry.media_kind === "photo"
            ? image
            : entry.media_kind === "video"
              ? video
              : audio;
        for (const other of [image, video, audio]) {
          if (other !== null && other !== player) other.remove();
        }
        if (player !== null && player !== undefined) {
          if (url === undefined) {
            // No signature, nothing to point the element at. An `<img>` with no
            // `src` is a broken-image icon and an empty player is a control
            // that does nothing when pressed; the label alone is the honest
            // render.
            player.remove();
          } else {
            player.setAttribute("src", url);
            if (player === image) player.setAttribute("alt", label);
          }
        }

        const open = item.querySelector<HTMLAnchorElement>("[data-media-open]");
        if (open) {
          if (url === undefined) open.remove();
          else {
            open.href = url;
            open.setAttribute("aria-label", `${open.textContent} — ${label}`);
          }
        }

        const drop = item.querySelector<HTMLButtonElement>(
          "[data-media-remove]"
        );
        drop?.setAttribute("aria-label", `${drop.textContent} — ${label}`);
        drop?.addEventListener("click", () => {
          if (!window.confirm(text.stringMediaRemoveConfirm ?? "")) return;
          void dropMedia(row, entry).catch(() => unreachable(els.mediaMessage));
        });

        els.mediaList.append(item);
      }
    }

    async function dropMedia(
      row: RecordRow,
      entry: RecordMediaRow
    ): Promise<void> {
      say(els.mediaMessage, "");
      const result = await removeRecordMedia(entry);
      if (!result.ok) {
        say(els.mediaMessage, text.stringError ?? "");
        return;
      }
      await paintMedia(row);
    }

    /**
     * Attach one file. There is nothing to validate beside it, and that is
     * GAR-06′'s point: the voice note the shop sent has no vendor.
     */
    async function attachMedia(row: RecordRow, file: File): Promise<void> {
      if (opened === null) return;
      say(els.mediaMessage, text.stringMediaUploading ?? "");
      const result = await uploadRecordMedia(opened.id, row.id, file);
      if (!result.ok) {
        say(
          els.mediaMessage,
          (result.reason === "rejected"
            ? text.stringMediaType
            : text.stringError) ?? ""
        );
        return;
      }
      say(els.mediaMessage, "");
      if (els.mediaFile) els.mediaFile.value = "";
      await paintMedia(row);
    }

    /* ---------------------------------------------------------- publishing */

    /**
     * The reader's sentence for every rule a candidate handle breaks.
     *
     * Every reason, joined, rather than the first one: `handleIssues` returns an
     * array precisely so a form does not make somebody guess which of two
     * problems to fix first (SHR-02).
     */
    function handleIssueMessage(issues: readonly HandleIssue[]): string {
      const messages: Record<HandleIssue, string | undefined> = {
        empty: text.stringHandleEmpty,
        "too-short": text.stringHandleShort,
        "too-long": text.stringHandleLong,
        "bad-characters": text.stringHandleCharacters,
        reserved: text.stringHandleReserved,
      };
      return issues
        .map((issue) => messages[issue] ?? "")
        .filter(Boolean)
        .join(" ");
    }

    /** Draw the handle panel from `profile` and `profileStatus`. */
    function paintHandle(): void {
      if (profileStatus === "failed") {
        // Not "you have no address": a request that did not arrive has not
        // established anything about this account.
        say(els.handleMessage, text.stringError ?? "");
        return;
      }
      if (profileStatus !== "loaded") return;

      const handle = profile?.handle ?? null;
      say(
        els.handleCurrent,
        handle === null
          ? (text.stringHandleNone ?? "")
          : (text.stringHandleCurrent ?? "{handle}").replace("{handle}", handle)
      );
      // Never over the reader's own typing: this runs on every profile change,
      // including one triggered while they are mid-word in the box.
      if (els.handleInput && document.activeElement !== els.handleInput) {
        els.handleInput.value = handle ?? "";
      }
      if (opened !== null) paintVisibility(opened);
    }

    /**
     * Claim, or change, the account's public address.
     *
     * The rules are checked here so the reader gets a sentence instead of a
     * round trip, and again in the database because that is where SHR-01 says
     * the guarantee lives. A handle this form would have accepted can still be
     * refused — it may be somebody else's, or somebody else's *former* one —
     * and that refusal is one sentence on purpose: distinguishing "taken" from
     * "retired" would turn the box into an oracle about other people's
     * accounts.
     */
    async function submitHandle(): Promise<void> {
      const input = els.handleInput;
      if (!input) return;
      const candidate = normalizeHandle(input.value);
      const issues = handleIssues(candidate);
      if (issues.length > 0) {
        say(els.handleMessage, handleIssueMessage(issues));
        return;
      }

      if (els.handleSave) els.handleSave.disabled = true;
      say(els.handleMessage, text.stringSaving ?? "");
      const outcome = await saveHandle(candidate);
      if (els.handleSave) els.handleSave.disabled = false;

      if (!outcome.ok) {
        say(
          els.handleMessage,
          (outcome.reason === "rejected"
            ? text.stringHandleUnavailable
            : text.stringError) ?? ""
        );
        return;
      }
      profile = outcome.value;
      profileStatus = "loaded";
      paintHandle();
      say(els.handleMessage, text.stringSaved ?? "");
    }

    /**
     * The two per-vehicle switches, from the row and from the account.
     *
     * A page cannot publish under an address that does not exist, so the
     * switches are inert until a handle is claimed — and the three reasons they
     * might be inert are kept apart, because they need different words:
     * the profile has not loaded (say nothing yet), it failed to load (say so),
     * or it loaded and carries no handle (say what to do about it) — that last
     * one through `visibilityGate`, not through the message line.
     *
     * The message line is therefore written on EVERY call, in both directions.
     * Setting it only on `"failed"` left the sentence on screen after the
     * status recovered: boot's `loadProfile` fails, the reader claims a handle
     * anyway, `submitHandle` succeeds and sets `profileStatus = "loaded"`,
     * `paintHandle` calls back in here — and the switches unlock underneath a
     * line still saying the request did not arrive (T2-402 review, Copilot). A
     * paint function that can only add is not a paint function; it is a log.
     */
    function paintVisibility(row: VehicleRow): void {
      const claimed = profileStatus === "loaded" && profile?.handle != null;
      if (els.visibilityGate) {
        els.visibilityGate.hidden = !(profileStatus === "loaded" && !claimed);
      }
      say(
        els.visibilityMessage,
        profileStatus === "failed" ? (text.stringError ?? "") : ""
      );
      for (const [control, open] of [
        [els.showcasePublic, row.is_showcase_public],
        [els.worklogPublic, row.is_worklog_public],
      ] as const) {
        if (!control) continue;
        control.checked = open;
        control.disabled = !claimed;
      }
    }

    /**
     * Throw one of the two switches.
     *
     * On failure the control is painted back from the row the database still
     * holds. A checkbox left showing a state the row does not have is a page
     * telling an owner their truck is published when it is not — the worst
     * available outcome, and the one an optimistic UI produces by default.
     */
    async function toggleVehicleVisibility(
      row: VehicleRow,
      patch: VehiclePublication,
      control: HTMLInputElement
    ): Promise<void> {
      control.disabled = true;
      say(els.visibilityMessage, text.stringSaving ?? "");
      const outcome = await setVehicleVisibility(row.id, patch);
      control.disabled = false;

      if (!outcome.ok) {
        paintVisibility(row);
        say(els.visibilityMessage, text.stringError ?? "");
        return;
      }
      replace(outcome.value);
      paintVisibility(outcome.value);
      say(els.visibilityMessage, text.stringSaved ?? "");
    }

    /**
     * The two per-record switches, or the note that says there is nothing to
     * open yet.
     *
     * A record has to exist before it can be published — the same shape the
     * receipts block already uses, and for the same reason: a control that
     * fails on click is less kind than a sentence saying to save first.
     */
    function paintRecordVisibility(row: RecordRow | null): void {
      if (els.recordVisibilityGate)
        els.recordVisibilityGate.hidden = row !== null;
      if (els.recordVisibility) els.recordVisibility.hidden = row === null;
      if (els.recordPublic) els.recordPublic.checked = row?.is_public ?? false;
      if (els.recordCostPublic) {
        els.recordCostPublic.checked = row?.is_cost_public ?? false;
      }
      say(els.recordVisibilityMessage, "");
    }

    /**
     * Open or close one record, or its cost, on the public work-log.
     *
     * Whichever switch was thrown is sent **alone**. Sending both would make
     * opening a record open its cost as a side effect, which is precisely the
     * collapse SHR-03 forbids — and it is invisible in a schema grader, because
     * both columns would still exist and both would still default to false.
     */
    async function toggleRecordVisibility(
      patch: RecordPublication,
      control: HTMLInputElement
    ): Promise<void> {
      const row = editingRecord;
      if (row === null) return;

      control.disabled = true;
      say(els.recordVisibilityMessage, text.stringSaving ?? "");
      const outcome = await setRecordVisibility(row.id, patch);
      control.disabled = false;

      if (!outcome.ok) {
        paintRecordVisibility(row);
        say(els.recordVisibilityMessage, text.stringError ?? "");
        return;
      }
      editingRecord = outcome.value;
      if (records !== null) {
        records = records.map((entry) =>
          entry.id === outcome.value.id ? outcome.value : entry
        );
      }
      paintRecordVisibility(outcome.value);
      say(els.recordVisibilityMessage, text.stringSaved ?? "");
    }

    /* ------------------------------------------------------------ requests */

    function replace(row: VehicleRow): void {
      const index = vehicles.findIndex((entry) => entry.id === row.id);
      if (index === -1) vehicles = [...vehicles, row];
      else
        vehicles = vehicles.map((entry) => (entry.id === row.id ? row : entry));
      if (opened?.id === row.id) opened = row;
      paintList();
    }

    async function load(): Promise<void> {
      const result = await listVehicles();
      if (!result.ok) {
        // A request that failed for any other reason leaves the prompt up and
        // says so: "sign in" is the only action a reader can take from here,
        // and it is the right one if the session turned out to be stale.
        settle(true);
        if (result.reason !== "signed-out") {
          say(els.message, text.stringError ?? "");
        }
        return;
      }
      vehicles = result.value;
      settle(false);
      els.app.hidden = false;
      paintList();
      show("list");

      /*
       * The handle, after the garage rather than beside it (T2-402, SHR-02).
       *
       * Sequential and not `Promise.all`: the vehicles are what the reader came
       * for, and a profile request that is slow — or that fails — must not hold
       * the garage behind it or turn a working page into an error one. Its own
       * outcome, its own message, its own part of the screen.
       */
      const mine = await loadProfile();
      profileStatus = mine.ok ? "loaded" : "failed";
      profile = mine.ok ? mine.value : null;
      paintHandle();
    }

    async function dropPhoto(row: VehicleRow, path: string): Promise<void> {
      say(els.photoMessage, "");
      const result = await removeVehiclePhoto(row, path);
      if (!result.ok) {
        say(els.photoMessage, text.stringError ?? "");
        return;
      }
      replace(result.value);
      await paintPhotos(result.value);
    }

    /* ------------------------------------------------------------- events */

    /* Publishing (T2-402, SHR-02 / SHR-03) */
    els.handleSave?.addEventListener("click", () => {
      void submitHandle().catch(() => unreachable(els.handleMessage));
    });
    els.handleInput?.addEventListener("keydown", (event) => {
      // The panel is not a `<form>` — it sits inside the vehicle list, and a
      // nested form is not legal markup — so Enter has to be wired by hand.
      // Without it the key does nothing, which reads as a broken box.
      if (event.key !== "Enter") return;
      event.preventDefault();
      void submitHandle().catch(() => unreachable(els.handleMessage));
    });

    els.showcasePublic?.addEventListener("change", () => {
      const control = els.showcasePublic;
      if (!control || opened === null) return;
      void toggleVehicleVisibility(
        opened,
        { is_showcase_public: control.checked },
        control
      ).catch(() => unreachable(els.visibilityMessage));
    });
    els.worklogPublic?.addEventListener("change", () => {
      const control = els.worklogPublic;
      if (!control || opened === null) return;
      void toggleVehicleVisibility(
        opened,
        { is_worklog_public: control.checked },
        control
      ).catch(() => unreachable(els.visibilityMessage));
    });

    els.recordPublic?.addEventListener("change", () => {
      const control = els.recordPublic;
      if (!control) return;
      void toggleRecordVisibility(
        { is_public: control.checked },
        control
      ).catch(() => unreachable(els.recordVisibilityMessage));
    });
    els.recordCostPublic?.addEventListener("change", () => {
      const control = els.recordCostPublic;
      if (!control) return;
      void toggleRecordVisibility(
        { is_cost_public: control.checked },
        control
      ).catch(() => unreachable(els.recordVisibilityMessage));
    });

    els.add?.addEventListener("click", () => openForm(null));
    els.cancel?.addEventListener("click", () => {
      show(opened === null ? "list" : "detail");
    });
    els.back?.addEventListener("click", () => {
      opened = null;
      show("list");
    });
    els.edit?.addEventListener("click", () => {
      if (opened !== null) openForm(opened);
    });

    els.generation?.addEventListener("change", () => refillIdentity());
    els.market?.addEventListener("change", () => refillEngines());
    els.year?.addEventListener("change", () => refillEngines());

    els.odometerUnit?.addEventListener("change", () => {
      const chosen = els.odometerUnit?.value === "mi" ? "mi" : "km";
      if (chosen === unit) return;
      // Re-render the field in the newly chosen unit from the stored row, so
      // switching units never re-parses a converted figure (see
      // `vehicleWriteFromDraft`'s note on the odometer that walks).
      const previous = editing;
      unit = chosen;
      writeOdometerUnit(unit, window);
      if (previous !== null && els.odometer) {
        els.odometer.value = draftFromVehicleRow(previous, unit).odometer;
      }
    });

    els.browse?.addEventListener("click", () => {
      if (opened === null) return;
      const selection = vehicleSelectionOf(opened);
      if (selection === null) return;
      // The seam `src/lib/vehicle-selection.ts` predicted: a signed-in
      // visitor's garage vehicle is a better source than a dropdown, and it
      // is written through the same function the selector writes through, so
      // every listing on the site re-filters on the same event.
      if (options !== null && !selectionIsOfferable(selection, options)) return;
      writeVehicleSelection(selection, window);
      say(els.browseNote, text.stringBrowsing ?? "");
    });

    for (const tab of root.querySelectorAll<HTMLButtonElement>(
      "[data-garage-tab]"
    )) {
      tab.addEventListener("click", () => selectTab(tab));
      tab.addEventListener("keydown", (event) => {
        const step =
          event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (step === 0) return;
        event.preventDefault();
        const tabs = [
          ...root.querySelectorAll<HTMLButtonElement>("[data-garage-tab]"),
        ];
        const next =
          tabs[(tabs.indexOf(tab) + step + tabs.length) % tabs.length];
        if (next) {
          selectTab(next);
          next.focus();
        }
      });
    }

    function selectTab(chosen: HTMLButtonElement): void {
      for (const tab of root.querySelectorAll<HTMLButtonElement>(
        "[data-garage-tab]"
      )) {
        const active = tab === chosen;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
      }
      for (const panel of root.querySelectorAll<HTMLElement>(
        "[data-garage-panel]"
      )) {
        panel.hidden = panel.dataset.garagePanel !== chosen.dataset.garageTab;
      }
    }

    els.photoInput?.addEventListener("change", () => {
      const file = els.photoInput?.files?.[0];
      if (!file || opened === null) return;
      const issue = photoIssue(file);
      if (issue !== null) {
        say(
          els.photoMessage,
          (issue === "too-large"
            ? text.stringPhotoSize
            : text.stringPhotoType) ?? ""
        );
        if (els.photoInput) els.photoInput.value = "";
        return;
      }
      const target = opened;
      say(els.photoMessage, text.stringUploading ?? "");
      void uploadVehiclePhoto(target, file)
        .then(async (result) => {
          if (els.photoInput) els.photoInput.value = "";
          if (!result.ok) {
            say(
              els.photoMessage,
              (result.reason === "rejected"
                ? text.stringPhotoType
                : text.stringError) ?? ""
            );
            return;
          }
          say(els.photoMessage, "");
          replace(result.value);
          await paintPhotos(result.value);
        })
        .catch(() => unreachable(els.photoMessage));
    });

    els.remove?.addEventListener("click", () => {
      if (editing === null) return;
      const target = editing;
      const confirmed = window.confirm(
        (text.stringDeleteConfirm ?? "").replace("{name}", target.display_name)
      );
      if (!confirmed) return;
      say(els.formMessage, text.stringDeleting ?? "");
      void deleteVehicle(target.id)
        .then((result) => {
          if (!result.ok) {
            say(els.formMessage, text.stringError ?? "");
            return;
          }
          vehicles = vehicles.filter((entry) => entry.id !== target.id);
          editing = null;
          opened = null;
          paintList();
          show("list");
        })
        .catch(() => unreachable(els.formMessage));
    });

    /* ------------------------------------------------- events: records */

    els.recordAdd?.addEventListener("click", () => {
      if (opened === null) return;
      void openRecordForm(null).catch(() => unreachable(els.recordMessage));
    });

    els.recordCancel?.addEventListener("click", () => {
      editingRecord = null;
      show(opened === null ? "list" : "detail");
    });

    els.recordCurrency?.addEventListener("change", () => {
      const chosen = els.recordCurrency?.value ?? "";
      if (chosen === "CRC" || chosen === "USD") {
        currency = chosen;
        writeCurrency(currency, window);
      }
    });

    els.recordTimeUnit?.addEventListener("change", () => {
      /*
       * The unit control changes how a figure is written, never which figure
       * it is — and there are two figures it could be.
       *
       * If the box still reads the stored value, `convertTimeField` re-renders
       * it from the row: the display is lossy (45 min shows as `0.8` h) and
       * converting *that* would write 48 back on the next save, which is F1
       * recurring one level up (T2-302 review, round 2). If the reader typed
       * something, it is converted, which is F4's fix and stays.
       *
       * Both cases are decided inside `convertTimeField`, against the same
       * rendering of the row that `recordWriteFromDraft`'s untouched guard
       * compares to — so the two cannot disagree about which figure this is.
       */
      const chosen = (els.recordTimeUnit?.value === "min" ? "min" : "h") as
        "h" | "min";
      if (!els.recordTime || chosen === recordTimeUnit) return;
      els.recordTime.value = convertTimeField(
        els.recordTime.value,
        recordTimeUnit,
        chosen,
        editingRecord?.time_minutes ?? null
      );
      recordTimeUnit = chosen;
    });

    els.recordDelete?.addEventListener("click", () => {
      if (editingRecord === null || opened === null) return;
      const target = editingRecord;
      const vehicle = opened;
      const confirmed = window.confirm(
        (text.stringRecordDeleteConfirm ?? "").replace(
          "{title}",
          recordHeadline(target, kindLabel(target.kind))
        )
      );
      if (!confirmed) return;
      say(els.recordMessage, text.stringDeleting ?? "");
      void deleteRecord(target.id)
        .then(async (result) => {
          if (!result.ok) {
            say(els.recordMessage, text.stringError ?? "");
            return;
          }
          editingRecord = null;
          show("detail");
          await loadRecords(vehicle);
        })
        .catch(() => unreachable(els.recordMessage));
    });

    els.receiptAttach?.addEventListener("click", () => {
      const file = els.receiptFile?.files?.[0];
      if (!file || editingRecord === null) return;
      const issue = receiptIssue(file);
      if (issue !== null) {
        say(
          els.receiptMessage,
          (issue === "too-large"
            ? text.stringReceiptSize
            : text.stringReceiptType) ?? ""
        );
        return;
      }
      void attachReceipt(editingRecord, file).catch(() =>
        unreachable(els.receiptMessage)
      );
    });

    els.mediaAttach?.addEventListener("click", () => {
      const file = els.mediaFile?.files?.[0];
      if (!file || editingRecord === null) return;
      // Refused here as well as in `uploadRecordMedia`, so the reader is told
      // which of the two things was wrong. The upload path can only say
      // "rejected".
      const issue = mediaIssue(file);
      if (issue !== null) {
        say(
          els.mediaMessage,
          (issue === "too-large"
            ? text.stringMediaSize
            : text.stringMediaType) ?? ""
        );
        return;
      }
      void attachMedia(editingRecord, file).catch(() =>
        unreachable(els.mediaMessage)
      );
    });

    els.recordForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (opened === null) return;
      const vehicle = opened;
      const draft = currentRecordDraft();
      const issues = validateRecordDraft(draft, catalogue);
      if (issues.length > 0) {
        say(els.recordMessage, recordIssueMessage(issues));
        return;
      }
      const write = recordWriteFromDraft(
        vehicle.id,
        draft,
        catalogue,
        editingRecord
      );
      if (write === null) {
        say(els.recordMessage, text.stringError ?? "");
        return;
      }

      if (els.recordSave) {
        els.recordSave.disabled = true;
        els.recordSave.textContent = text.stringSaving ?? "";
      }
      const request =
        editingRecord === null
          ? createRecord(write)
          : updateRecord(editingRecord.id, write);

      void request
        .then(async (result) => {
          if (!result.ok) {
            say(els.recordMessage, text.stringError ?? "");
            return;
          }
          say(els.message, text.stringSaved ?? "");
          // Straight back to the form on the saved row, so a new record's
          // receipts can be attached without hunting for it on the rail.
          await openRecordForm(result.value);
          await loadRecords(vehicle);
        })
        .catch(() => unreachable(els.recordMessage))
        .finally(() => {
          if (els.recordSave) {
            els.recordSave.disabled = false;
            els.recordSave.textContent = els.recordSave.dataset.idle ?? "";
          }
        });
    });

    els.form.addEventListener("submit", (event) => {
      event.preventDefault();
      const draft = currentDraft();
      const issues = validateVehicleDraft(draft);
      if (issues.length > 0) {
        say(els.formMessage, issueMessage(issues));
        return;
      }
      const write = vehicleWriteFromDraft(draft, editing);
      if (write === null) {
        say(els.formMessage, text.stringError ?? "");
        return;
      }

      if (els.save) {
        els.save.disabled = true;
        els.save.textContent = text.stringSaving ?? "";
      }
      const request =
        editing === null
          ? createVehicle(write)
          : updateVehicle(editing.id, write);

      void request
        .then((result) => {
          if (!result.ok) {
            say(els.formMessage, text.stringError ?? "");
            return;
          }
          replace(result.value);
          say(els.message, text.stringSaved ?? "");
          openDetail(result.value);
          editing = null;
        })
        .catch(() => unreachable(els.formMessage))
        .finally(() => {
          if (els.save) {
            els.save.disabled = false;
            els.save.textContent = els.save.dataset.idle ?? "";
          }
        });
    });

    /* --------------------------------------------------------------- boot */

    void currentUserIdIfAny(window)
      .then((userId) => {
        if (userId === null) {
          settle(true);
          return;
        }
        return load();
      })
      .catch(() => unreachable());
  }

  const root = document.querySelector<HTMLElement>("[data-garage]");
  // No project configured means no client, no chunk fetched, and nothing on
  // this page to wire up — the notice the server rendered is the whole page.
  if (root && SUPABASE_BROWSER_CONFIG) enhance(root);
</script>

<style>
  /*
   * Tokens from specs/001-foundation/design/HANDOFF-DESIGN.md's Taller
   * artboard, scoped to this page — the same note the sign-in, glossary and
   * community pages carry: site-wide chrome tokens belong to the task that
   * restyles the chrome.
   */
  .garage {
    --paper: #f7f4ee;
    --panel: #ffffff;
    --panel-soft: #fbf9f4;
    --ink: #2b2620;
    --muted: #6e6559;
    --muted-strong: #55493c;
    --faint: #a99c88;
    --line: #e4ddd1;
    --chip: #efe9dd;
    --rust: #b0532a;
    --rust-deep: #93441f;
    --rust-tint: #fbeee6;
    --rust-tint-border: #e9cdbb;

    font-family: Archivo, "Helvetica Neue", Arial, sans-serif;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 52rem;
  }

  /*
   * F10 (T2-303 review sweep): closing the whole class of bug, not the next
   * instance of it.
   *
   * An author-origin `display: flex`/`grid` on a descendant beats the
   * user-agent `[hidden] { display: none }` rule, so any element under
   * `.garage` that carries `hidden` — from its initial server-rendered
   * markup, or set by the script at runtime — can still render laid out.
   * That has now shipped four separate times as one-off per-selector
   * patches on this one page (`.garage__gate`, the T2-303 derived-sheet
   * trio, the chip/link rows, the receipt form — see the removed comments
   * this rule supersedes below), and a fifth review pass found *five more*
   * elements nobody had patched yet: `[data-garage-app]` itself — so a
   * signed-out visitor was served the entire garage application, gate and
   * all, laid out beneath the sign-in prompt — plus `[data-garage-empty]`,
   * `[data-garage-detail-view]`, `[data-garage-form]` and
   * `[data-garage-record-form]`. Chasing each new leak with its own
   * `.foo[hidden] { display: none }` is exactly the pattern that keeps
   * producing the next one, because it depends on every future
   * `display: flex`/`grid` declaration under `.garage` remembering to pair
   * itself with a same-specificity guard — an invariant nothing enforces.
   *
   * This rule enforces the invariant once, for the whole subtree, so no
   * descendant of `.garage` — present or future — can ever compute a
   * display other than `none` while it carries `hidden`, regardless of
   * what layout rule targets it. `!important` is deliberate and is the one
   * `!important` on this page: relying on selector specificity to always
   * outrank an unknown, growing set of `display: flex`/`grid` declarations
   * is the trap itself, not a defense against it. `tests/e2e/hidden-guard.spec.ts`
   * (the automated version of the T2-303 reviewer's manual sweep) is the
   * grader that keeps this true; its mutation check requires this exact
   * rule to exist.
   */
  .garage [hidden] {
    display: none !important;
  }

  .garage__intro {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .garage__intro h1 {
    margin: 0;
    font-size: 1.875rem;
    font-weight: 800;
    letter-spacing: -0.3px;
  }

  .garage__intro p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted-strong);
  }

  /*
   * The boot line exists only where scripting does, and the sign-in prompt is
   * what a scriptless visitor gets — so the swap happens in CSS, before first
   * paint, rather than by revealing a block after hydration. Same reasoning as
   * the vehicle selector: a block revealed late pushes the page around.
   */
  .garage__boot {
    display: none;
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted-strong);
  }

  :global(html.js) .garage[data-garage-state="boot"] .garage__boot {
    display: block;
  }

  /*
   * While the session is still being resolved, and only where scripting can
   * resolve it, the sign-in prompt stands down. A scriptless visitor never
   * leaves `boot` — but never gets the `html.js` class either, so for them the
   * prompt is simply the page.
   */
  :global(html.js) .garage[data-garage-state="boot"] .garage__gate {
    display: none;
  }

  /*
   * This element used to carry its own `.garage__gate[hidden] { display:
   * none }` guard (the same bug the glossary and community toolbars shipped
   * once each). Superseded by the page-wide `.garage [hidden]` rule near the
   * top of this block (F10) — kept here only as the historical note in case
   * a future reader remembers this guard and goes looking for it.
   */
  .garage__gate {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .garage__gate h2 {
    margin: 0;
    font-size: 1.1875rem;
    font-weight: 700;
  }

  .garage__gate p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted-strong);
  }

  .garage__cta {
    display: inline-block;
    min-height: 44px;
    padding: 0.625rem 1rem;
    color: #ffffff;
    background: var(--rust);
    border: 1px solid var(--rust);
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
  }

  .garage__cta:hover {
    background: var(--rust-deep);
    border-color: var(--rust-deep);
  }

  .garage__app {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .garage__panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .garage__panel-head,
  .garage__detail-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .garage__panel h2,
  .garage__panel h3,
  .garage__detail-name {
    margin: 0;
    font-size: 1.1875rem;
    font-weight: 700;
  }

  .garage__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .garage__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: var(--panel-soft);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .garage__row-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .garage__row-name {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  /* Every datum renders in Plex Mono (HANDOFF-DESIGN typography). */
  .garage__row-identity,
  .garage__identity,
  .garage__stat dd,
  .garage__input--data,
  .garage__select--data {
    font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace;
  }

  .garage__row-identity,
  .garage__identity {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .garage__identity {
    margin: 0;
  }

  .garage__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 1rem;
    background: var(--panel-soft);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .garage__stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .garage__stat dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .garage__stat dd {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .garage__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .garage__tab {
    font: inherit;
    min-height: 44px;
    padding: 0.5rem 1rem;
    color: var(--muted-strong);
    background: var(--panel-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }

  .garage__tab[aria-selected="true"] {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }

  .garage__tabpanel {
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }

  .garage__empty-note,
  .garage__note,
  .garage__hint,
  .garage__fineprint {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .garage__empty {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted-strong);
  }

  /* ---------------------------------------------------------------------
   * Publishing (T2-402, SHR-02 / SHR-03)
   *
   * Quiet blocks with a rule under them rather than another card. Turning a
   * page on is a decision made once and then left alone, so it earns a
   * heading and a divider — not the timeline's ink, which belongs to the
   * thing a reader actually scrolls.
   * ------------------------------------------------------------------ */

  .garage__handle,
  .garage__visibility {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block-end: 1.5rem;
    padding-block-end: 1.5rem;
    border-block-end: 1px solid var(--line);
  }

  .garage__handle > h2,
  .garage__visibility > h3 {
    margin: 0;
  }

  /*
   * A checkbox, its label, and the sentence saying what throwing it does.
   *
   * Grid rather than flex so the hint lands under the *label* and not under
   * the box: a hint indented to the control reads as part of the control's
   * own name, and these two hints are the difference between "open the page"
   * and "open the whole history".
   */
  .garage__check {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
    margin: 0;
  }

  .garage__checkbox {
    inline-size: 1rem;
    block-size: 1rem;
    margin: 0;
    accent-color: var(--rust);
  }

  .garage__check > .garage__hint {
    grid-column: 2;
  }

  /* ---------------------------------------------------------------------
   * The derived sheets (T2-303, GAR-03′)
   *
   * Deliberately plainer than the timeline. The rail is the artboard's
   * signature and it earns its ink by being the thing a reader scrolls; the
   * current-state sheet and the planned queue's summary are reference
   * material read once, so they are set as quiet stacked blocks rather than
   * competing with it. The queue's cards are the timeline's own template, so
   * the one thing that *is* the artboard's design stays the artboard's.
   * ------------------------------------------------------------------ */

  /*
   * Why these three needed their own `[hidden]` guard (T2-303 review, F9),
   * now superseded by the page-wide `.garage [hidden]` rule (F10) — the
   * finding is worth keeping even though the fix moved.
   *
   * `.garage__sheet` is what `paintCurrentState` hides while the records are
   * in flight, so without a guard, opening vehicle B while its request was
   * still running showed B's loading notice with **vehicle A's** odometer
   * still asserted underneath it as computed fact — and it persisted into
   * the failure state, which is the whole class of wrong answer this task
   * exists to prevent. `.garage__sheet-block` is the group wrapper, so an
   * empty "Past their date" heading rendered over nothing. `.garage__sheet-list`
   * was included pre-emptively because it was the same trap waiting.
   */
  .garage__sheet {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .garage__sheet-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .garage__sheet-block > h3 {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-strong);
  }

  .garage__sheet-figure {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .garage__sheet-list {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .garage__sheet-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    justify-content: space-between;
    padding-bottom: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.5;
    border-bottom: 1px solid var(--line);
  }

  .garage__sheet-line:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .garage__sheet-line-name {
    color: var(--ink);
  }

  /*
   * A reference entry the site can no longer resolve, named by its own id.
   * Marked rather than dropped — a retired entry must not silently delete a
   * line of somebody's service history — and marked with an underline here
   * rather than the chips' dashed border, because this element has no border
   * for a border-style to show up on.
   */
  .garage__sheet-line-name--unresolved {
    color: var(--muted);
    text-decoration: underline dotted;
    text-underline-offset: 0.2em;
  }

  .garage__sheet-line-meta {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  /*
   * An estimate row is three parts, not two: label, figure, and the coverage
   * that keeps the figure honest. The coverage takes the full width under the
   * pair so it reads as belonging to *this* row — the whole point of F1's fix
   * was that a coverage sentence floating under a stack of rows attaches
   * itself to whichever one the reader was looking at.
   */
  .garage__sheet-line--estimate {
    row-gap: 0.125rem;
  }

  .garage__sheet-line-coverage {
    flex-basis: 100%;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ---------------------------------------------------------------------
   * The timeline (HANDOFF-DESIGN, Taller artboard)
   *
   * A vertical `line` rail with a dot per entry: filled rust for what
   * happened, hollow for what is planned. The planned card is `panel-soft`
   * with a dashed border and an amber badge; a done card is `panel` with a
   * solid one and a green badge. Every difference between the two is driven
   * by one class on the `<li>`, set from `kind`.
   *
   * One deliberate departure from the artboard: the `date · odometer` meta
   * line is `--muted` rather than `--faint`. `#A99C88` measures **2.45:1** on
   * `--paper` (`#f7f4ee`), which is the substrate this line actually sits on,
   * and 2.69:1 even on white; this site holds itself to WCAG 2.1 AA, where
   * body text needs 4.5:1. The artboard's *hierarchy* is kept — the meta line
   * is still the quietest thing in the card — at a colour a reader can read.
   * ------------------------------------------------------------------- */

  .garage__timeline {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
    margin: 0;
    padding: 0 0 0 1.75rem;
    list-style: none;
  }

  .garage__timeline:empty {
    display: none;
  }

  .garage__timeline::before {
    content: "";
    position: absolute;
    left: 0.4rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--line);
  }

  .garage__entry {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .garage__entry-dot {
    position: absolute;
    left: -1.75rem;
    top: 0.25rem;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: var(--rust);
    border: 3px solid var(--paper);
    box-sizing: border-box;
  }

  .garage__entry--planned .garage__entry-dot {
    background: var(--panel);
    border-color: var(--rust);
  }

  .garage__entry-meta {
    font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .garage__card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.125rem 1.25rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .garage__entry--planned .garage__card {
    background: var(--panel-soft);
    border: 1.5px dashed #c9bfaf;
  }

  .garage__card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .garage__card-title {
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .garage__badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.625rem;
    border-radius: 4px;
    color: #2f5e3f;
    background: #e4efe7;
  }

  .garage__entry--planned .garage__badge {
    color: #7a5210;
    background: #fdf3e4;
  }

  .garage__chips,
  .garage__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * These two used to carry their own `[hidden]` guard, superseded by the
   * page-wide `.garage [hidden]` rule (F10).
   */

  .garage__chip {
    font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace;
    font-size: 0.75rem;
    color: var(--muted-strong);
    background: var(--chip);
    border-radius: 4px;
    padding: 0.1875rem 0.5rem;
  }

  .garage__minichip {
    font-size: 0.75rem;
    color: var(--muted-strong);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.1875rem 0.5rem;
  }

  .garage__minichip--unresolved {
    color: var(--muted);
    border-style: dashed;
  }

  .garage__card-body {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted-strong);
    /* The user's own notes, written in lines, kept in lines. */
    white-space: pre-wrap;
  }

  .garage__card-body:empty {
    display: none;
  }

  .garage__card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /*
   * Real text, off-screen: it is translated, selectable and read aloud, which
   * an `aria-label` on a list item is not reliably any of.
   */
  .garage__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .garage__textarea {
    font: inherit;
    font-size: 1rem;
    padding: 0.625rem 0.75rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 6px;
    resize: vertical;
  }

  .garage__textarea:focus-visible,
  .garage__multi:focus-visible {
    outline: 2px solid var(--rust);
    outline-offset: 1px;
  }

  .garage__multi {
    min-height: 6rem;
    padding: 0.375rem;
  }

  .garage__receipts,
  .garage__receipt-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /*
   * `.garage__receipt-form` used to carry its own `[hidden]` guard,
   * superseded by the page-wide `.garage [hidden]` rule (F10).
   */

  .garage__receipt-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .garage__receipt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    background: var(--panel-soft);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .garage__receipt-text {
    font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8125rem;
    color: var(--muted-strong);
  }

  /*
   * Media attachments (GAR-06′) — "alongside but visually distinct from
   * receipts", which the task asks for and which is also the requirement: an
   * attachment that reads as a receipt is a financial claim about a photo of a
   * broken bracket.
   *
   * The distinction is structural rather than decorative. Receipts are a
   * dense monospace line — vendor, date, amount — because they are read as
   * data. These are a stack: a name, then the thing itself. The dashed rule
   * and the inset are the only chrome, so the two sections are told apart at a
   * glance without a second colour to explain.
   */
  .garage__receipts--media {
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line);
  }

  .garage__media-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .garage__media {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    background: var(--panel-soft);
    border: 1px dashed var(--line);
    border-radius: 6px;
  }

  .garage__media-text {
    font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8125rem;
    color: var(--muted-strong);
  }

  .garage__media-image,
  .garage__media-player {
    display: block;
    width: 100%;
    /* A tall phone photo must not push the whole grid row down with it. */
    max-height: 14rem;
    border-radius: 4px;
  }

  .garage__media-image {
    object-fit: cover;
  }

  /* An `<audio>` element has no picture to fit; its own height is correct. */
  .garage__media-player[data-media-audio] {
    max-height: none;
  }

  .garage__media-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .garage__photos {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .garage__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .garage__photo {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .garage__photo-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--chip);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .garage__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
  }

  .garage__fieldset {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .garage__legend {
    padding: 0 0.375rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .garage__label {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .garage__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .garage__input,
  .garage__select,
  .garage__file {
    font: inherit;
    font-size: 1rem;
    min-height: 44px;
    padding: 0.625rem 0.75rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .garage__input:focus-visible,
  .garage__select:focus-visible,
  .garage__file:focus-visible,
  .garage__tab:focus-visible,
  .garage__button:focus-visible,
