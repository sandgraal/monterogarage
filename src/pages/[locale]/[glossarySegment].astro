---
/**
 * The public glossary page (GLO-04).
 *
 * > **GLO-04** THE glossary SHALL render as a public bilingual reference
 * > page, filterable by system (engine, brakes, suspension, …).
 *
 * ## One page, two URLs, one component
 *
 * The segment is translated — `/en/glossary/` and `/es/glosario/` — so the
 * file is parameterized on it and `getStaticPaths` reads both values from the
 * registry in `src/i18n/routes.ts`. Neither locale is a redirect or a
 * translation of the other: both are built from this component (I18N-01).
 * `routePathByLocale` is what lets `BaseLayout` emit the right hreflang pair
 * and lets the locale switcher cross between the two segments instead of
 * landing on a URL that was never built.
 *
 * ## Bilingual by construction
 *
 * Every card shows the term in **both** languages and the definition in
 * **both** languages, page locale first. That is not a nicety here — a
 * glossary whose Spanish page hid the English term would be useless to
 * exactly the reader it exists for (someone holding a US parts catalogue in a
 * Costa Rican taller). Each block carries its own `lang` so a screen reader
 * switches voice, and so the browser's translate feature leaves the other
 * language alone.
 *
 * ## Filtering
 *
 * Filtering is client-side and progressive: the search box and the system
 * pills are laid out only when the document is marked script-capable, so a
 * visitor without JavaScript sees every term and no dead controls, and the
 * first render is the complete, indexable page. The script builds each
 * card's search haystack once, from the same text the card already renders
 * (`glossary-filter.ts`'s `buildHaystack`) rather than a second
 * server-rendered copy — at 153 terms that duplicate `data-haystack` copy
 * was ~73 kB of the ~383 kB page, which is what pushed SCF-06's Lighthouse
 * performance budget under 90. An alias search (`rin` → `aro`, SRCH-02's
 * shape) still works with no index and no fetch; it costs one JS pass over
 * the already-downloaded DOM instead of extra HTML. The real search index is
 * T702.
 *
 * ## The headword — owner ruling, 2026-08-28
 *
 * **The locale's own term leads.** On `/es/glosario/` the big word is the
 * Costa Rican term and the English one is the gloss; on `/en/glossary/` it is
 * the other way round. The artboard shows the ES term leading on both pages,
 * and the owner ruled for per-locale leading instead: an English reader
 * scanning ~150 cards needs their own headword to scan by, and I18N-01's
 * "neither locale privileged" applies to the card as much as to the URL. The
 * conductor is recording the deviation in HANDOFF-DESIGN.md.
 *
 * ## Styling
 *
 * Palette, type scale and card anatomy follow
 * `specs/001-foundation/design/artboards/Glosario.dc.html`, with three
 * deliberate departures, all required by constraints the handoff itself
 * lists:
 *
 * 1. The artboard's `faint` (#A99C88) fails WCAG AA on paper and on white
 *    (2.5:1 and 2.7:1 against a 4.5:1 requirement), so secondary text uses
 *    `muted` (#6E6559, 5.3:1).
 * 2. `See also` links sit on a `chip` background, where the handoff's `rust`
 *    measures 4.22:1 under Pa11y — they use `rust-deep` (5.6:1) instead.
 * 3. The Archivo / IBM Plex Mono webfonts are *named* but not loaded here:
 *    loading a webfont is a site-chrome decision (T204 owns it), not
 *    something one page should do to the whole site's performance budget.
 *    Declaring the families means this page picks them up the day they load.
 *
 * refs specs/001-foundation (GLO-01, GLO-04, I18N-01, I18N-04, I18N-08)
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  LOCALES,
  LOCALE_BCP47,
  isLocale,
  type Locale,
} from "../../i18n/routing";
import { collectionRouteParams, collectionRoutePaths } from "../../i18n/routes";
import VehicleFitSummary from "../../components/VehicleFitSummary.astro";
import { glossarySystemLabel, t } from "../../i18n/ui";
import { formatCount, glossaryTermDomId } from "../../lib/glossary-filter";
import { buildFitmentTable } from "../../lib/vehicle-listing";
import {
  GLOSSARY_SYSTEMS,
  canonicalTermOf,
  type GlossarySystem,
} from "../../schemas/glossary";

export function getStaticPaths() {
  return collectionRouteParams("glossary", "glossarySegment");
}

const { locale: param } = Astro.params;
if (!isLocale(param)) {
  throw new Error(`Unknown locale segment: ${String(param)}`);
}
const locale: Locale = param;
const strings = t(locale);
const routes = collectionRoutePaths("glossary");

/** The other locale, shown alongside the page locale on every card. */
const otherLocales = LOCALES.filter((candidate) => candidate !== locale);
/** Page locale first — the handoff's rule for every bilingual block. */
const readingOrder: Locale[] = [locale, ...otherLocales];

const collator = new Intl.Collator(LOCALE_BCP47[locale], {
  sensitivity: "base",
});

const entries = await getCollection("glossary");

/**
 * One card's worth of already-resolved values. Built here rather than in the
 * template so the sort key and the DOM id each exist once. There is no
 * server-built search haystack any more — the client script derives it from
 * the rendered card itself (`glossary-filter.ts`'s `buildHaystack`), so the
 * searchable text exists in the HTML exactly once instead of twice.
 */
const terms = entries
  .map((entry) => {
    const { system, aliases, relatedTerms, prose, fitment } = entry.data;
    const termByLocale = Object.fromEntries(
      LOCALES.map((each) => [each, canonicalTermOf(entry.data, each)])
    ) as Record<Locale, string>;

    return {
      id: entry.id,
      /** `/` appears in ids derived from nested files; it is not id-safe. */
      domId: glossaryTermDomId(entry.id),
      system: system as GlossarySystem,
      /** Read by the vehicle filter; never interpreted on this page (FIT-01). */
      fitment,
      aliases,
      relatedTerms,
      termByLocale,
      definitionByLocale: Object.fromEntries(
        LOCALES.map((each) => [each, prose[each].summary])
      ) as Record<Locale, string>,
    };
  })
  .sort((a, b) =>
    collator.compare(a.termByLocale[locale], b.termByLocale[locale])
  );

/**
 * One entry per *distinct* fitment. 142 of the 154 terms declare the identical
 * all-generations fitment, so this is the difference between ~19 kB of escaped
 * JSON attributes and one small table (T204 review, F3).
 */
const fitmentTable = buildFitmentTable(terms.map((term) => term.fitment));

/** Canonical term per entry id, for rendering `relatedTerms` as real words. */
const termById = new Map(terms.map((term) => [term.id, term]));

/**
 * Only systems that actually have a term get a pill: a filter that can only
 * ever return nothing is a broken control, not a feature. Order follows
 * `GLOSSARY_SYSTEMS` (service-manual order), never insertion order.
 */
const systemsInUse = GLOSSARY_SYSTEMS.filter((system) =>
  terms.some((term) => term.system === system)
);
---

<BaseLayout
  locale={locale}
  routePathByLocale={routes}
  title={`${strings.glossaryHeading} — ${strings.siteTagline}`}
  description={strings.glossaryIntro}
>
  <section class="glossary" data-glossary>
    <div class="glossary__intro">
      <h1>{strings.glossaryHeading}</h1>
      <p>{strings.glossaryIntro}</p>
    </div>

    {
      terms.length === 0 ? (
        <p class="glossary__empty">{strings.glossaryEmpty}</p>
      ) : (
        <>
          <div class="glossary__toolbar" data-glossary-toolbar>
            <div class="glossary__search">
              <label class="visually-hidden" for="glossary-search">
                {strings.glossarySearchLabel}
              </label>
              <svg
                class="glossary__search-icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
                focusable="false"
              >
                <circle cx="11" cy="11" r="7" />
                <path d="m21 21-4.3-4.3" />
              </svg>
              <input
                id="glossary-search"
                type="search"
                autocomplete="off"
                data-glossary-search
                placeholder={strings.glossarySearchPlaceholder}
              />
            </div>
            <div
              class="glossary__filters"
              role="group"
              aria-label={strings.glossaryFilterLabel}
            >
              <button type="button" data-system="" aria-pressed="true">
                {strings.glossaryFilterAll}
              </button>
              {systemsInUse.map((system) => (
                <button type="button" data-system={system} aria-pressed="false">
                  {glossarySystemLabel(strings, system)}
                </button>
              ))}
            </div>
          </div>

          <p
            class="glossary__count"
            data-glossary-count
            data-count-template={strings.glossaryCountTemplate}
            data-total={String(terms.length)}
            aria-live="polite"
          >
            {formatCount(
              strings.glossaryCountTemplate,
              terms.length,
              terms.length
            )}
          </p>

          <VehicleFitSummary locale={locale} fitments={fitmentTable.table} />

          <ul class="glossary__list" data-glossary-list>
            {terms.map((term) => (
              <li
                class="term"
                id={term.domId}
                data-system={term.system}
                data-fitment={fitmentTable.indexOf(term.fitment)}
              >
                <div class="term__head">
                  <h2 class="term__title">
                    <span class="term__canonical" lang={LOCALE_BCP47[locale]}>
                      {term.termByLocale[locale]}
                    </span>
                    {otherLocales.map((other) => (
                      <span class="term__gloss" lang={LOCALE_BCP47[other]}>
                        {term.termByLocale[other]}
                      </span>
                    ))}
                  </h2>
                  <span class="term__system" data-system={term.system}>
                    {glossarySystemLabel(strings, term.system)}
                  </span>
                </div>

                {readingOrder.map((each) => (
                  <p class="term__definition" lang={LOCALE_BCP47[each]}>
                    {term.definitionByLocale[each]}
                  </p>
                ))}

                {term.aliases.length > 0 && (
                  <p class="term__aliases">
                    <span class="term__label">
                      {strings.glossaryAliasesLabel}
                    </span>
                    {term.aliases.map((alias) => (
                      <span
                        class:list={[
                          "alias",
                          alias.falseFriend && "alias--false-friend",
                        ]}
                      >
                        <span
                          class="alias__term"
                          lang={LOCALE_BCP47[alias.locale]}
                        >
                          {alias.term}
                        </span>
                        <span class="alias__countries">
                          {alias.countries.join("/")}
                        </span>
                        {alias.falseFriend && (
                          <span class="alias__warning">
                            {strings.glossaryFalseFriendLabel}
                          </span>
                        )}
                      </span>
                    ))}
                  </p>
                )}

                {term.relatedTerms.length > 0 && (
                  <p class="term__related">
                    <span class="term__label">
                      {strings.glossaryRelatedLabel}
                    </span>
                    {term.relatedTerms.map((id) => {
                      const target = termById.get(id);
                      return target ? (
                        <a class="related" href={`#${target.domId}`}>
                          {target.termByLocale[locale]}
                        </a>
                      ) : null;
                    })}
                  </p>
                )}
              </li>
            ))}
          </ul>

          <p class="glossary__none" data-glossary-none hidden>
            {strings.glossaryNoResults}
          </p>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  import {
    buildHaystack,
    formatCount,
    matchesFilter,
  } from "../../lib/glossary-filter";
  import { buildTaxonomy } from "../../lib/fitment";
  import { readSelectorPayload } from "../../lib/vehicle-taxonomy";
  import { createVehicleListingView } from "../../lib/vehicle-listing";
  import {
    onVehicleSelectionChange,
    readVehicleSelection,
    type StoredVehicleSelection,
  } from "../../lib/vehicle-selection";

  /**
   * Client-side filtering (GLO-04) and the vehicle filter (T204, FIT-03).
   * Enhancement only: the toolbar is laid out only when the document is
   * marked script-capable, so a visitor with no JavaScript sees the whole
   * glossary and never a control that does nothing.
   *
   * Only DOM wiring lives here — which elements to read, what to toggle. The
   * decisions (does this card match? what does the counter say? what counts
   * as its searchable text? does this term apply to the reader's truck?) are
   * pure functions in `src/lib/glossary-filter.ts` and
   * `src/lib/vehicle-listing.ts`, unit-tested without a browser.
   */
  function enhance(root: HTMLElement): void {
    const toolbar = root.querySelector<HTMLElement>("[data-glossary-toolbar]");
    const search = root.querySelector<HTMLInputElement>(
      "[data-glossary-search]"
    );
    const count = root.querySelector<HTMLElement>("[data-glossary-count]");
    const none = root.querySelector<HTMLElement>("[data-glossary-none]");
    if (!toolbar || !search || !count || !none) return;

    // The haystack is read from each card's own rendered text — never a
    // second server-serialized copy — and built exactly once here, not on
    // every keystroke: `apply()` runs on every `input` event, so recomputing
    // it per keystroke would trade the removed page weight for repeated
    // DOM walks instead.
    const cards = [...root.querySelectorAll<HTMLElement>(".term")].map(
      (element) => ({
        element,
        system: element.dataset.system ?? "",
        haystack: buildHaystack(haystackSourceFromCard(element)),
      })
    );

    const template = count.dataset.countTemplate ?? "";
    const total = Number(count.dataset.total ?? cards.length);
    const buttons = [
      ...toolbar.querySelectorAll<HTMLButtonElement>("[data-system]"),
    ];
    let system = "";

    /*
     * The vehicle filter (FIT-03: "any collection listing"). Same module and
     * therefore the same semantics as the community directory — dim, tag,
     * never hide — reading the taxonomy the selector already inlined.
     * `buildTaxonomy([])` keeps this harmless on a page with no selector.
     */
    const vehicle = createVehicleListingView({
      root,
      cards: cards.map((card) => card.element),
      taxonomy: buildTaxonomy(readSelectorPayload(document)?.nodes ?? []),
      lang: document.documentElement.lang,
    });

    function applyVehicle(selection: StoredVehicleSelection | null): void {
      vehicle?.apply(selection);
    }

    function apply(): void {
      const state = { system, query: search!.value };
      let shown = 0;

      for (const card of cards) {
        const visible = matchesFilter(card, state);
        card.element.hidden = !visible;
        if (visible) shown += 1;
      }

      count!.textContent = formatCount(template, shown, total);
      none!.hidden = shown > 0;
      applyVehicle(readVehicleSelection(window));
    }

    for (const button of buttons) {
      button.addEventListener("click", () => {
        system = button.dataset.system ?? "";
        for (const other of buttons) {
          other.setAttribute(
            "aria-pressed",
            String((other.dataset.system ?? "") === system)
          );
        }
        apply();
      });
    }

    search.addEventListener("input", apply);
    // The selector lives in the site chrome and knows nothing about this page;
    // it announces, and the listing re-marks itself (FIT-03).
    onVehicleSelectionChange(window, (selection) => applyVehicle(selection));
    apply();
  }

  /**
   * Read one card's searchable parts straight from what it already renders —
   * the two term spans, both definitions, the system chip, and every alias
   * chip's term and country tags. Nothing here is new text: it is the same
   * content the reader can already see, just gathered for `buildHaystack`.
   */
  function haystackSourceFromCard(card: HTMLElement) {
    const textOf = (selector: string) =>
      [...card.querySelectorAll<HTMLElement>(selector)].map(
        (element) => element.textContent ?? ""
      );

    return {
      terms: textOf(".term__canonical, .term__gloss"),
      definitions: textOf(".term__definition"),
      system:
        card.querySelector<HTMLElement>(".term__system")?.textContent ?? "",
      aliases: [...card.querySelectorAll<HTMLElement>(".alias")].map(
        (alias) => ({
          term: alias.querySelector(".alias__term")?.textContent ?? "",
          countries:
            alias.querySelector(".alias__countries")?.textContent ?? "",
        })
      ),
    };
  }

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-glossary]"
  )) {
    enhance(root);
  }
</script>

<style is:global>
  /*
   * Palette from specs/001-foundation/design/HANDOFF-DESIGN.md, scoped to this
   * page: site-wide design tokens belong to the task that restyles the chrome,
   * not to the first collection page that needs colours.
   *
   * `is:global` + every selector prefixed with `.glossary` is a deliberate
   * substitute for Astro's default *scoped* `<style>`: scoped CSS works by
   * stamping a `data-astro-cid-…` attribute onto every element this
   * component renders, including every element inside the `terms.map()`
   * loop below. At 153 terms that was ~3,200 attributes — one of the
   * largest single contributors to the page weight that put SCF-06's
   * Lighthouse performance budget under 90 (T205 follow-up). Prefixing every
   * rule with `.glossary` gets the same real isolation (nothing outside
   * `<section class="glossary">` can match) without an attribute on every
   * node — a per-term cost that only grows as the ~45 queued cognate terms
   * land, so removing it is not just today's fix but headroom for that
   * growth.
   */
  .glossary {
    --paper: #f7f4ee;
    --panel: #ffffff;
    /* HANDOFF-DESIGN: "de-emphasized cards (planned work, filtered-out rows)". */
    --panel-soft: #fbf9f4;
    --ink: #2b2620;
    --muted: #6e6559;
    --muted-strong: #55493c;
    --line: #e4ddd1;
    --chip: #efe9dd;
    --rust: #b0532a;
    --rust-deep: #93441f;
    --green: #3e6b4f;
    --green-tint: #e4efe7;
    --warn-ink: #8a5e14;
    --warn-tint: #fdf3e4;
    --warn-line: #b07a1f;

    font-family: Archivo, "Helvetica Neue", Arial, sans-serif;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 75rem;
  }

  .glossary .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .glossary .glossary__intro {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .glossary .glossary__intro h1 {
    margin: 0;
    font-size: 1.875rem;
    font-weight: 800;
    letter-spacing: -0.3px;
  }

  .glossary .glossary__intro p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
    max-width: 62ch;
  }

  /*
   * T204, the same pair of findings as on the sibling community page (see the
   * long note there). The toolbar's `hidden` attribute was overridden by this
   * `display: flex`, so the search box and system pills were visible and inert
   * with JavaScript off — against the contract stated in this file's own
   * docstring. Hiding them properly then moved the whole term list down when
   * the script revealed the toolbar, which is a layout shift on every load.
   *
   * `BaseLayout` marks the document `js` before first paint, so the question
   * is answered by CSS in the first layout: laid out when scripting is
   * available, absent when it is not.
   */
  .glossary .glossary__toolbar {
    display: none;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  :global(html.js) .glossary .glossary__toolbar {
    display: flex;
  }

  .glossary .glossary__search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: 1 1 18rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.5rem 1rem;
    color: var(--muted);
  }

  .glossary .glossary__search input {
    flex: 1;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 0.875rem;
    color: var(--ink);
    min-height: 1.75rem;
  }

  .glossary .glossary__search input::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .glossary .glossary__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .glossary .glossary__filters button {
    font: inherit;
    font-size: 0.8125rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    min-height: 2.75rem;
    background: var(--panel);
    color: var(--muted-strong);
    cursor: pointer;
  }

  .glossary .glossary__filters button[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
    font-weight: 700;
  }

  .glossary .glossary__count,
  .glossary .glossary__none,
  .glossary .glossary__empty {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .glossary .glossary__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .glossary .term {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.25rem 1.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .glossary .term[hidden] {
    display: none;
  }

  /*
   * The Selector artboard's third state, applied to a term card (T204):
   * a word that does not apply to the reader's truck is de-emphasized, not
   * removed. `src/lib/vehicle-listing.ts` adds the "filtered" tag that says
   * so in words, because opacity is not information to a reader who cannot
   * see it.
   */
  .glossary .term[data-fits="false"] {
    background: var(--panel-soft);
    opacity: 0.55;
  }

  .glossary .term__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }

  .glossary .term__title {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 1.1875rem;
    font-weight: 700;
  }

  .glossary .term__gloss {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--muted);
  }

  .glossary .term__gloss::before {
    content: "— ";
  }

  .glossary .term__system {
    flex: 0 0 auto;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--green);
    background: var(--green-tint);
    border-radius: 4px;
    padding: 0.1875rem 0.5rem;
  }

  .glossary .term__definition {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted-strong);
  }

  .glossary .term__aliases,
  .glossary .term__related {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  .glossary .term__label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
  }

  .glossary .alias,
  .glossary .related {
    font-family:
      "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    background: var(--chip);
    border-radius: 4px;
    padding: 0.125rem 0.5rem;
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .glossary .alias__countries {
    color: var(--muted);
  }

  .glossary .alias--false-friend {
    background: var(--warn-tint);
    border: 1px solid var(--warn-line);
  }

  .glossary .alias__warning {
    color: var(--warn-ink);
    font-weight: 600;
  }

  /*
   * The handoff's link colour is `rust` on `rust-deep` hover, but these links
   * sit on a `chip` background rather than on paper or panel: rust there is
